# ── App ──────────────────────────────────────────────────────────────
APP_ENV=production                # production | development
APP_URL=https://b2b.shoesclothingstore.com
APP_TIMEZONE=Europe/Rome

# ── Database (docker compose usa questi stessi valori) ───────────────
DB_DRIVER=mysql                   # mysql | sqlite (sqlite SOLO per sviluppo/test senza Docker)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=b2b_catalog
DB_USER=b2b
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root  # usato solo dal container mysql

# ── Autenticazione ───────────────────────────────────────────────────
# Gli account clienti si creano da /admin/clienti (invito via email).
# La password condivisa resta come "modalità ospite" di transizione:
# spegnila (GUEST_LOGIN_ENABLED=0) quando tutti i clienti hanno l'account.
GUEST_LOGIN_ENABLED=1
# Genera gli hash con: php bin/hash-password.php "la-password"
# ⚠ IMPORTANTE: racchiudi gli hash tra APICI SINGOLI — contengono "$" che
#   Docker Compose altrimenti interpola come variabili, mutilando l'hash.
#   Es: CATALOG_PASSWORD_HASH='$argon2id$v=19$m=65536,...'
#   Vale per QUALSIASI valore contenente "$" (anche DB/SMTP password).
CATALOG_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=
SESSION_LIFETIME_DAYS=7
# Subnet fidate per X-Forwarded-For (helper PHP; nginx fa già set_real_ip_from).
# Vuoto = usa sempre REMOTE_ADDR. Es: TRUSTED_PROXY_SUBNETS=172.18.0.0/16
TRUSTED_PROXY_SUBNETS=

# ── Feed GoldenSneakers ──────────────────────────────────────────────
FEED_SOURCE=fixture               # fixture | live  (fixture finché manca il token)
FEED_BASE_URL=https://www.goldensneakers.net
FEED_ENDPOINT=/api/assortment-flat/
FEED_BEARER_TOKEN=                # riservato: mai committare
FEED_FIXTURE_PATH=fixtures/goldensneakers-dev.json  # usata con FEED_SOURCE=fixture
FEED_SYNC_INTERVAL=7200           # secondi tra i sync del cron (default 2h)
FEED_HTTP_TIMEOUT=60
IMAGE_CACHE_LOCAL=0               # 1 = scarica e serve le immagini in locale (previsto, non attivo in v1)

# ── Ordini dropship GoldenSneakers (vedi docs/09) ────────────────────
# Crea l'ordine direttamente presso il fornitore (dominio "order-dropship"
# dell'API), così lo stock GoldenSneakers resta allineato.
# ⚠ Con DROPSHIP_MODE=simulation NESSUNA chiamata parte: il flusso viene
#   solo registrato e mostrato come SIMULAZIONE. Con DROPSHIP_MODE=live il
#   client invia DAVVERO (auth: FEED_BEARER_TOKEN): creare un ordine è
#   IRREVERSIBILE e ha un costo reale. PRIMA di attivare il live: verificare
#   i due endpoint qui sotto sullo Swagger del fornitore
#   (/api/docs/v1/swagger/schema/, richiede il bearer token) — sono ancora
#   NON confermati. Qualsiasi valore diverso da "live" degrada a simulazione.
DROPSHIP_ENABLED=1                # 1 = mostra la sezione in /admin
DROPSHIP_MODE=simulation          # simulation | live
DROPSHIP_HTTP_TIMEOUT=30          # secondi per le chiamate live (min 5)
# Tetto sul costo fornitore stimato di UN ordine dropship: oltre questa
# cifra l'invio viene rifiutato prima della chiamata. 0 = nessun tetto.
DROPSHIP_MAX_ORDER_EUR=0
# ⚠ Auto-dropship alla RICHIESTA del cliente (per bloccare lo stock del
#   fornitore prima che arrivi il bonifico). Chiunque abbia accesso al
#   catalogo può quindi generare ordini verso il fornitore: kill-switch qui.
#   In simulation nessuna chiamata parte; l'esito è nell'email admin.
AUTO_DROPSHIP_ON_REQUEST=0        # 1 = crea l'ordine dropship a ogni richiesta
# ⚠⚠ In live l'auto-dropship invia ordini REALI innescati dal cliente, senza
#    passaggio admin: serve anche questo opt-in esplicito (0 = in live
#    l'auto-dropship rifiuta e resta solo il flusso manuale a 3 conferme).
AUTO_DROPSHIP_ALLOW_LIVE=0
DROPSHIP_CREATE_ENDPOINT=/api/orders-dropship/create/          # DA VERIFICARE su Swagger
DROPSHIP_DETAILS_ENDPOINT=/api/orders-dropship/order-details/  # DA VERIFICARE su Swagger

# ── Pricing ──────────────────────────────────────────────────────────
# I margini (per brand/nome + default) si gestiscono da /admin/margini e
# vivono a DB (margin_rules + settings); le aliquote VAT per paese in vat_rates.
# I prezzi di listino sono NETTI (VAT esclusa): l'imposta si calcola solo
# alla richiesta d'ordine in base al paese del cliente.
PRICE_ROUNDING=whole              # whole | half | none (arrotondamento del prezzo netto)

# ── Regole catalogo ──────────────────────────────────────────────────
MIN_ORDER_ITEMS=5
AVAILABILITY_HIGH_MIN=60          # pezzi totali per "Alta disponibilità"
AVAILABILITY_LOW_MAX=20           # pezzi totali per "Bassa disponibilità"
PRODUCTS_PER_PAGE=24

# ── Spedizione ───────────────────────────────────────────────────────
# Tariffa forfettaria netta (VAT esclusa), gratuita dalla soglia in su.
# La spedizione è accessoria ai beni: entra nell'imponibile VAT dell'ordine.
FREE_SHIPPING_MIN_ITEMS=7         # da 7 paia in su la spedizione è gratuita
SHIPPING_FEE=10.00                # sotto soglia (EUR, VAT esclusa)
# Tempi di consegna dichiarati sulle pagine pubbliche (/spedizioni, /come-ordinare)
SHIPPING_DAYS_MIN=4
SHIPPING_DAYS_MAX=5

# ── Email ────────────────────────────────────────────────────────────
# AWS SES (endpoint SMTP, consigliato — vedi README § Email via AWS SES):
#   SMTP_HOST=email-smtp.eu-south-1.amazonaws.com   (Milano; o eu-central-1, ecc.)
#   SMTP_PORT=587
#   SMTP_USER=<SES SMTP username>       ⚠ credenziali SMTP dedicate, NON l'access key IAM
#   SMTP_PASSWORD='<SES SMTP password>' ⚠ apici singoli se contiene "$"
#   SMTP_ENCRYPTION=tls
# MAIL_FROM_ADDRESS deve essere un'identità VERIFICATA in SES (dominio o indirizzo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls               # tls | ssl
MAIL_FROM_ADDRESS=noreply@shoesclothingstore.com
MAIL_FROM_NAME="SHOES & CLOTHING RESELLING"
ADMIN_EMAIL=info@shoesclothingstore.com
ADMIN_EMAIL_SHOW_COST=1           # include costo fornitore e margine nell'email admin

# ── Pagamento via bonifico (unico canale attuale) ────────────────────
# Mostrati in /contatti, nel modal al checkout e nell'email di istruzioni
# pagamento. Finché BANK_IBAN è vuoto si mostra l'invito a contattarci.
BANK_ACCOUNT_HOLDER=
BANK_NAME=
BANK_IBAN=
BANK_BIC=

# ── Contatti pubblici (pagina /contatti) ─────────────────────────────
CONTACT_COMPANY_NAME="SHOES & CLOTHING RESELLING OFFICIAL STORE"
CONTACT_EMAIL=shoes.clothing_reselling@yahoo.com
CONTACT_PHONE="+39 392 772 0691"
CONTACT_WHATSAPP="+393927720691"
CONTACT_ADDRESS="Via Paolo Ricci 12/a, 76121 Barletta (BT)"
CONTACT_VAT="P.IVA 091460600729"
MAIN_SITE_URL=https://shoesclothingstore.com/
