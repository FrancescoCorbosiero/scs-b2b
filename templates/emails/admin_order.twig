{# Email amministratore (sempre in italiano): tabella ordine completa.
   offer_price e margine SOLO se show_cost. I totali di listino sono netti (VAT esclusa). #}
<div style="font-family: Arial, Helvetica, sans-serif; color: #171717; max-width: 720px;">
    <h1 style="font-size: 20px;">Nuova richiesta d'ordine #{{ order.id }}</h1>
    <p style="margin: 4px 0;"><strong>Data:</strong> {{ order.created_at }}</p>
    <p style="margin: 4px 0;"><strong>Cliente:</strong> {{ order.customer_name }}{% if order.company %} — {{ order.company }}{% endif %}</p>
    <p style="margin: 4px 0;"><strong>Email:</strong> {{ order.email }} · <strong>Telefono:</strong> {{ order.phone }}</p>
    {% if order.notes %}<p style="margin: 4px 0;"><strong>Note:</strong> {{ order.notes }}</p>{% endif %}
    <p style="margin: 4px 0;"><strong>Paese:</strong> {{ order.country_code }} — {{ t('country.' ~ order.country_code) }}
       {% if order.vat_number %} · <strong>P.IVA:</strong> {{ order.vat_number }}{% endif %}</p>
    {% if order.address_street %}
        <p style="margin: 4px 0;"><strong>Spedizione:</strong> {{ order.address_street }}, {{ order.address_zip }} {{ order.address_city }} ({{ order.country_code }})</p>
    {% endif %}
    {% if (order.ship_to ?? 'reseller') == 'customer' %}
        <p style="margin: 8px 0; padding: 8px 10px; border-radius: 8px; border: 1px solid #ddd6fe; background: #f5f3ff;">
            <strong>DROPSHIPPING — consegna al cliente finale del rivenditore:</strong><br>
            {{ order.recipient_name }} — {{ order.recipient_street }}, {{ order.recipient_zip }} {{ order.recipient_city }} ({{ order.recipient_country }}) — tel. {{ order.recipient_phone }}
            {% if (order.client_provides_label ?? 0) == 1 %}
                <br><strong>⚠ Etichetta fornita dal rivenditore:</strong> il fornitore NON spedirà finché non carichiamo etichetta e tracking (da /admin/dropship, sezione etichetta).
            {% endif %}
        </p>
    {% endif %}
    <p style="margin: 8px 0; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 8px 10px;">
        <strong>In attesa di pagamento (bonifico).</strong> Alla ricezione, conferma la richiesta da
        /admin/richieste/{{ order.id }}: partirà l'email di conferma al cliente con la ricevuta pro-forma.
    </p>
    {% if auto_dropship is defined and auto_dropship %}
        {% set ok = auto_dropship.ok %}
        {% set skipped = auto_dropship.skipped ?? false %}
        <p style="margin: 8px 0; padding: 8px 10px; border-radius: 8px; border: 1px solid {{ ok ? '#a7f3d0' : (skipped ? '#e5e5e5' : '#fecaca') }}; background: {{ ok ? '#ecfdf5' : (skipped ? '#fafafa' : '#fef2f2') }};">
            {% if ok %}
                <strong>Ordine GoldenSneakers{% if auto_dropship.vendor_order_id and not auto_dropship.simulated %} n. {{ auto_dropship.vendor_order_id }}{% endif %} creato automaticamente</strong>
                (registrazione #{{ auto_dropship.dropship_id }}) {{ auto_dropship.simulated ? '— SIMULAZIONE: nessuna chiamata reale inviata.' : '— modalità LIVE.' }}
                {# il totale GoldenSneakers è un COSTO: solo con ADMIN_EMAIL_SHOW_COST=1 #}
                {% if show_cost and not auto_dropship.simulated and auto_dropship.total_amount is not null %}
                    <br>Totale GoldenSneakers: <strong>{{ auto_dropship.total_amount|eur }}</strong>
                    {% if auto_dropship.shipping_cost is not null %} (spedizione {{ auto_dropship.shipping_cost > 0 ? auto_dropship.shipping_cost|eur : 'gratuita' }}){% endif %}
                    — da pagare al fornitore: pro-forma e stato in /admin/ordini-fornitore.
                {% endif %}
            {% elseif skipped %}
                <strong>Nessun ordine GoldenSneakers:</strong> {{ auto_dropship.message }}
            {% else %}
                <strong>Ordine GoldenSneakers automatico NON creato:</strong> {{ auto_dropship.message }}
                — gestiscilo manualmente da /admin/richieste/{{ order.id }}/dropship.
            {% endif %}
        </p>
    {% endif %}

    <table cellpadding="6" cellspacing="0" border="1" style="border-collapse: collapse; border-color: #d4d4d4; font-size: 13px; margin-top: 12px; width: 100%;">
        <thead>
            <tr style="background: #f5f5f5;">
                <th align="left">SKU</th>
                <th align="left">Prodotto</th>
                <th align="left">Taglia EU</th>
                <th align="left">Taglia US</th>
                <th align="left">Barcode</th>
                <th align="right">Qty</th>
                <th align="right">Prezzo unit. (netto)</th>
                <th align="right">Subtotale</th>
                {% if show_cost %}
                    <th align="right">Costo unit.</th>
                    <th align="right">Margine riga</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for line in order.lines %}
                <tr>
                    <td>{{ line.sku }}</td>
                    <td>{{ line.name }}{% if (line.source ?? 'feed') == 'custom' %} <strong style="color: #6d28d9;">[IN SEDE — spedizione a tuo carico]</strong>{% endif %}</td>
                    <td>{{ line.size_eu }}</td>
                    <td>{{ line.size_us }}</td>
                    <td>{{ line.barcode }}</td>
                    <td align="right">{{ line.qty }}</td>
                    <td align="right">{{ line.unit_price|eur }}</td>
                    <td align="right"><strong>{{ line.subtotal|eur }}</strong></td>
                    {% if show_cost %}
                        <td align="right">{{ line.offer_price is defined and line.offer_price ? line.offer_price|eur : '—' }}</td>
                        <td align="right">
                            {% if line.offer_price is defined and line.offer_price %}
                                {{ ((line.unit_price - line.offer_price) * line.qty)|eur }}
                            {% else %}—{% endif %}
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p style="font-size: 15px; margin-top: 14px;">
        <strong>Totale pezzi:</strong> {{ order.total_items }}<br>
        <strong>Imponibile (VAT esclusa):</strong> {{ order.total_amount|eur }}<br>
        <strong>Spedizione:</strong> {{ (order.shipping_amount ?? 0) > 0 ? (order.shipping_amount|eur) : 'gratuita' }}<br>
        <strong>VAT
            {%- if order.vat_scheme == 'reverse_charge' %} (reverse charge, 0%)
            {%- elseif order.vat_scheme == 'export' %} (export, 0%)
            {%- else %} ({{ order.vat_rate }}%)
            {%- endif %}:</strong> {{ order.vat_amount|eur }}<br>
        <strong>Totale:</strong> {{ order.total_gross|eur }}
    </p>
</div>
