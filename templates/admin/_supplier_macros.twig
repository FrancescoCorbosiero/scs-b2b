{# Badge degli ordini GoldenSneakers (solo area admin). Gli stati che il
   fornitore aggiunge in futuro non hanno traduzione: si mostra il valore
   grezzo invece della chiave di lingua. #}

{% macro status(value) %}
    {% if value %}
        {% set key = 'dropship.status.' ~ value %}
        {% set label = t(key) %}
        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase whitespace-nowrap
            {{ value == 'UNKNOWN' ? 'bg-red-50 border-red-200 text-red-700'
             : value in ['ENDED', 'TO_SHIP'] ? 'bg-emerald-50 border-emerald-200 text-emerald-700'
             : value == 'CANCELED' ? 'bg-neutral-100 border-neutral-300 text-neutral-500'
             : 'bg-amber-50 border-amber-200 text-amber-800' }}">
            {{ label == key ? value : label }}
        </span>
    {% else %}
        <span class="text-neutral-400">—</span>
    {% endif %}
{% endmacro %}

{# stato del NOSTRO pagamento a GoldenSneakers (pro-forma da saldare) #}
{% macro payment(value, is_paid) %}
    {% if value or is_paid is same as(true) or is_paid is same as(false) %}
        {% set key = 'supplier.payment.' ~ (value ?: (is_paid ? 'paid' : 'unpaid')) %}
        {% set label = t(key) %}
        {% set paid = is_paid is same as(true) or value == 'paid' %}
        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase whitespace-nowrap
            {{ paid ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-orange-50 border-orange-200 text-orange-700' }}">
            {{ label == key ? value : label }}
        </span>
    {% else %}
        <span class="text-neutral-400">—</span>
    {% endif %}
{% endmacro %}
