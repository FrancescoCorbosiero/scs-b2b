{% extends 'layout.twig' %}

{% block title %}{{ t('admin.dashboard') }} — {{ t('admin.title') }}{% endblock %}

{% block content %}
    <h1 class="text-2xl font-bold mb-6">{{ t('admin.dashboard') }}</h1>

    <div class="grid sm:grid-cols-3 gap-4 mb-8 max-w-4xl">
        {# ogni scheda porta all'elenco/dettaglio corrispondente: tutta la card è cliccabile #}
        <a href="/admin/richieste" class="group bg-white rounded-xl border border-neutral-200 p-5 block hover:bg-amber-50/50 hover:border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-500 transition-colors">
            <p class="text-sm text-neutral-500 flex items-center gap-1">
                {{ t('admin.orders_total') }}
                <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-900 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </p>
            <p class="text-3xl font-black">{{ orders_total }}</p>
        </a>
        <a href="/admin/richieste?stato=pending" class="group bg-white rounded-xl border p-5 block hover:bg-amber-50/50 focus:outline-none focus:ring-2 focus:ring-amber-500 transition-colors
           {{ (orders_by_status.pending ?? 0) > 0 ? 'border-amber-300' : 'border-neutral-200' }}">
            <p class="text-sm text-neutral-500 flex items-center gap-1">
                {{ t('admin.orders_pending') }}
                <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-900 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </p>
            <p class="text-3xl font-black {{ (orders_by_status.pending ?? 0) > 0 ? 'text-amber-600' }}">{{ orders_by_status.pending ?? 0 }}</p>
        </a>
        <a href="/admin/sync" class="group bg-white rounded-xl border border-neutral-200 p-5 block hover:bg-amber-50/50 hover:border-amber-300 focus:outline-none focus:ring-2 focus:ring-amber-500 transition-colors">
            <p class="text-sm text-neutral-500 flex items-center gap-1">
                {{ t('admin.last_sync') }}
                <svg class="w-4 h-4 text-neutral-300 group-hover:text-neutral-900 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </p>
            {% if last_sync %}
                <p class="font-semibold {{ last_sync.status == 'ok' ? 'text-emerald-600' : 'text-red-600' }}">
                    {{ last_sync.status|upper }} — {{ last_sync.started_at }}
                </p>
                <p class="text-xs text-neutral-500 mt-1">
                    {{ t('admin.rows_read') }}: {{ last_sync.rows_read }} ·
                    {{ t('admin.created') }}: {{ last_sync.products_created }} ·
                    {{ t('admin.updated') }}: {{ last_sync.products_updated }} ·
                    {{ t('admin.deactivated') }}: {{ last_sync.products_deactivated }}
                </p>
            {% else %}
                <p class="text-neutral-400">{{ t('admin.sync_never') }}</p>
            {% endif %}
        </a>
    </div>

    <h2 class="font-bold text-lg mb-3">{{ t('admin.orders') }}</h2>
    {% include 'admin/_orders_table.twig' with { orders: recent_orders } %}
    <a href="/admin/richieste" class="inline-block mt-4 text-sm underline text-neutral-600 hover:text-neutral-900">{{ t('admin.orders') }} →</a>
{% endblock %}
