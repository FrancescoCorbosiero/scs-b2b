{% extends 'layout.twig' %}

{% block title %}{{ t('signup.admin_title') }} — {{ t('admin.title') }}{% endblock %}

{% block content %}
    <div class="mb-2 flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold">{{ t('signup.admin_title') }}</h1>
        {% if pending_count > 0 %}
            <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-800">{{ t('signup.admin_pending_count', {n: pending_count}) }}</span>
        {% endif %}
    </div>
    <p class="mb-6 max-w-3xl text-sm text-neutral-500">{{ t('signup.admin_intro') }}</p>

    <div class="mb-4 flex flex-wrap gap-2 text-sm">
        <a href="/admin/richieste-profilo"
           class="rounded-lg border px-3 py-1.5 font-medium {{ status is null ? 'border-neutral-900 bg-neutral-900 text-white' : 'border-neutral-300 bg-white hover:bg-neutral-50' }}">
            {{ t('admin.filter_all') }}
        </a>
        {% for st in ['pending', 'approved', 'rejected'] %}
            <a href="/admin/richieste-profilo?stato={{ st }}"
               class="rounded-lg border px-3 py-1.5 font-medium {{ status == st ? 'border-neutral-900 bg-neutral-900 text-white' : 'border-neutral-300 bg-white hover:bg-neutral-50' }}">
                {{ t('signup.status_' ~ st) }}
            </a>
        {% endfor %}
    </div>

    <div class="space-y-3">
        {% for r in requests %}
            {% set st = r.status ?? 'pending' %}
            <article class="rounded-xl border bg-white p-5 {{ st == 'pending' ? 'border-amber-300' : 'border-neutral-200' }}">
                <div class="flex flex-wrap items-start gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="text-lg font-bold">{{ r.company }}</h2>
                            <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase
                                {{ st == 'approved' ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                                 : st == 'rejected' ? 'border-red-200 bg-red-50 text-red-700'
                                 : 'border-amber-200 bg-amber-50 text-amber-800' }}">
                                {{ t('signup.status_' ~ st) }}
                            </span>
                            <span class="text-xs text-neutral-400">#{{ r.id }} · {{ r.created_at }}</span>
                        </div>
                        <div class="mt-3 grid gap-x-6 gap-y-1.5 text-sm sm:grid-cols-2">
                            <p><span class="text-neutral-500">{{ t('admin.customer') }}:</span> <strong>{{ r.name }}</strong></p>
                            <p><span class="text-neutral-500">Email:</span> <a class="underline" href="mailto:{{ r.email }}">{{ r.email }}</a></p>
                            <p><span class="text-neutral-500">{{ t('contact.phone') }}:</span> {{ r.phone }}</p>
                            <p><span class="text-neutral-500">{{ t('admin.vat_number') }}:</span> <span class="font-mono">{{ r.vat_number ?: '—' }}</span></p>
                            <p class="sm:col-span-2">
                                <span class="text-neutral-500">{{ t('admin.shipping_address') }}:</span>
                                {{ r.address_street }}, {{ r.address_zip }} {{ r.address_city }} —
                                <strong>{{ r.country_code }}</strong> ({{ t('country.' ~ r.country_code) }})
                            </p>
                            {% if r.notes %}<p class="sm:col-span-2"><span class="text-neutral-500">{{ t('order.notes') }}:</span> {{ r.notes }}</p>{% endif %}
                        </div>
                        <p class="mt-2 text-xs text-neutral-400">
                            IP {{ r.ip_address }} · {{ t('admin.language') }} {{ r.locale|upper }}
                            {% if r.reviewed_at %} · {{ t('signup.admin_reviewed_at') }} {{ r.reviewed_at }}{% endif %}
                        </p>
                    </div>

                    {% if st == 'pending' %}
                        <div class="flex shrink-0 flex-col gap-2">
                            <form method="post" action="/admin/richieste-profilo/{{ r.id }}/approva"
                                  data-confirm="{{ t('signup.admin_approve_confirm')|e('html_attr') }}">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <button type="submit" class="w-full rounded-lg bg-emerald-600 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-emerald-500">
                                    {{ t('signup.admin_approve') }}
                                </button>
                            </form>
                            <form method="post" action="/admin/richieste-profilo/{{ r.id }}/rifiuta"
                                  data-confirm="{{ t('signup.admin_reject_confirm')|e('html_attr') }}">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <button type="submit" class="w-full rounded-lg border border-neutral-300 px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-neutral-50">
                                    {{ t('signup.admin_reject') }}
                                </button>
                            </form>
                        </div>
                    {% elseif st == 'approved' and r.user_id %}
                        <a href="/admin/clienti" class="shrink-0 text-sm font-semibold underline text-neutral-500 hover:text-neutral-900">
                            {{ t('signup.admin_see_customer') }}
                        </a>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="rounded-xl border border-neutral-200 bg-white p-10 text-center text-neutral-400">{{ t('signup.admin_none') }}</div>
        {% endfor %}
    </div>
{% endblock %}
