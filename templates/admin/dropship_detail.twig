{% extends 'layout.twig' %}

{% block title %}{{ t('dropship.detail_title') }} #{{ ds.id }} — {{ t('admin.title') }}{% endblock %}

{% block content %}
    {% if ds.order_request_id %}
        <a href="/admin/richieste/{{ ds.order_request_id }}" class="text-sm underline text-neutral-500 hover:text-neutral-900">← {{ t('dropship.detail_request') }} #{{ ds.order_request_id }}</a>
    {% else %}
        <a href="/admin/richieste" class="text-sm underline text-neutral-500 hover:text-neutral-900">← {{ t('admin.orders') }}</a>
    {% endif %}
    <div class="flex flex-wrap items-center gap-3 mt-2 mb-6">
        <h1 class="text-2xl font-bold">{{ t('dropship.detail_title') }} #{{ ds.id }}</h1>
        {% if ds.mode == 'simulation' %}
            <span class="inline-flex items-center rounded-full bg-sky-100 text-sky-800 border border-sky-200 px-3 py-0.5 text-xs font-bold uppercase">{{ t('dropship.simulation_badge') }}</span>
        {% endif %}
        <span class="inline-flex items-center rounded-full bg-neutral-100 text-neutral-700 border border-neutral-200 px-3 py-0.5 text-xs font-semibold">{{ t('dropship.status.' ~ ds.status) }}</span>
    </div>

    {% if ds.mode == 'simulation' %}
        <div class="mb-4 rounded-lg px-4 py-3 text-sm border bg-sky-50 border-sky-200 text-sky-900">
            {{ t('dropship.simulation_banner') }}
        </div>
    {% endif %}

    <div class="grid lg:grid-cols-3 gap-5 items-start">
        <div class="lg:col-span-2 space-y-5">
            <div class="bg-white rounded-xl border border-neutral-200 overflow-x-auto">
                <h2 class="font-semibold px-5 pt-4">{{ t('dropship.items_title') }}</h2>
                <table class="w-full text-sm mt-3">
                    <thead>
                        <tr class="bg-neutral-50 text-neutral-500 text-left">
                            <th class="px-3 py-2.5 font-medium">SKU</th>
                            <th class="px-3 py-2.5 font-medium">Prodotto</th>
                            <th class="px-3 py-2.5 font-medium">EU/US</th>
                            <th class="px-3 py-2.5 font-medium text-right">{{ t('dropship.col_size_id') }}</th>
                            <th class="px-3 py-2.5 font-medium text-right">Qty</th>
                            <th class="px-3 py-2.5 font-medium text-right">{{ t('admin.cost') }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-neutral-100">
                        {% for line in lines %}
                            <tr>
                                <td class="px-3 py-2 font-mono text-xs">{{ line.sku }}</td>
                                <td class="px-3 py-2">{{ line.name }}</td>
                                <td class="px-3 py-2 whitespace-nowrap">{{ line.size_eu }}{% if line.size_us %} / {{ line.size_us }}{% endif %}</td>
                                <td class="px-3 py-2 text-right font-mono text-xs">{{ line.supplier_size_id ?? '—' }}</td>
                                <td class="px-3 py-2 text-right font-semibold">{{ line.qty }}</td>
                                <td class="px-3 py-2 text-right text-neutral-500 whitespace-nowrap">{{ line.offer_price|eur }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ── Ultima lettura dal fornitore (order-details) ─────────── #}
            <div class="bg-white rounded-xl border border-neutral-200 overflow-x-auto">
                <div class="flex flex-wrap items-baseline justify-between gap-2 px-5 pt-4">
                    <h2 class="font-semibold">{{ t('dropship.vendor_section') }}</h2>
                    {% if details_fetched_at %}
                        <span class="text-xs text-neutral-400">{{ t('dropship.vendor_fetched_at', {at: details_fetched_at}) }}</span>
                    {% endif %}
                </div>
                {% if vendor_order %}
                    <table class="w-full text-sm mt-3">
                        <thead>
                            <tr class="bg-neutral-50 text-neutral-500 text-left">
                                <th class="px-3 py-2.5 font-medium">SKU</th>
                                <th class="px-3 py-2.5 font-medium">Prodotto</th>
                                <th class="px-3 py-2.5 font-medium">US</th>
                                <th class="px-3 py-2.5 font-medium text-right">{{ t('dropship.col_size_id') }}</th>
                                <th class="px-3 py-2.5 font-medium text-right">Qty</th>
                                <th class="px-3 py-2.5 font-medium text-right">{{ t('dropship.vendor_unit_price') }}</th>
                                <th class="px-3 py-2.5 font-medium text-right">{{ t('dropship.vendor_line_total') }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-neutral-100">
                            {% for item in vendor_order.items ?? [] %}
                                <tr>
                                    <td class="px-3 py-2 font-mono text-xs">{{ item.sku ?? '—' }}</td>
                                    <td class="px-3 py-2">{{ item.product_name ?? '—' }}</td>
                                    <td class="px-3 py-2 whitespace-nowrap">{{ item.size_us ?? '—' }}</td>
                                    <td class="px-3 py-2 text-right font-mono text-xs">{{ item.size_id ?? '—' }}</td>
                                    <td class="px-3 py-2 text-right font-semibold">{{ item.quantity ?? '—' }}</td>
                                    <td class="px-3 py-2 text-right text-neutral-500 whitespace-nowrap">{{ item.unit_price is defined ? item.unit_price|eur : '—' }}</td>
                                    <td class="px-3 py-2 text-right whitespace-nowrap">{{ item.total_price is defined ? item.total_price|eur : '—' }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="7" class="px-3 py-3 text-neutral-500 text-xs">{{ t('dropship.vendor_no_items') }}</td></tr>
                            {% endfor %}
                        </tbody>
                        {% if vendor_order.total_amount is defined and vendor_order.total_amount is not null %}
                            <tfoot>
                                <tr class="border-t border-neutral-200">
                                    <td colspan="6" class="px-3 py-2.5 text-right text-neutral-500">{{ t('dropship.vendor_total') }} ({{ vendor_order.currency ?? 'EUR' }})</td>
                                    <td class="px-3 py-2.5 text-right font-bold whitespace-nowrap">{{ vendor_order.total_amount|eur }}</td>
                                </tr>
                            </tfoot>
                        {% endif %}
                    </table>
                    {% if vendor_order.created_at is defined and vendor_order.created_at %}
                        <p class="px-5 pb-4 pt-2 text-xs text-neutral-400">{{ t('dropship.vendor_created') }}: {{ vendor_order.created_at }}</p>
                    {% endif %}
                {% else %}
                    <p class="px-5 pb-4 pt-2 text-sm text-neutral-500">{{ t('dropship.vendor_none') }}</p>
                {% endif %}
            </div>

            <div class="bg-white rounded-xl border border-neutral-200 p-5">
                <h2 class="font-semibold mb-2">{{ t('dropship.payload_title') }}</h2>
                <pre class="text-xs bg-neutral-900 text-neutral-100 rounded-lg p-4 overflow-x-auto">{{ request_json }}</pre>
            </div>

            {% if response_json %}
                <div class="bg-white rounded-xl border border-neutral-200 p-5">
                    <h2 class="font-semibold mb-2">{{ t('dropship.response_title') }}</h2>
                    <pre class="text-xs bg-neutral-900 text-neutral-100 rounded-lg p-4 overflow-x-auto">{{ response_json }}</pre>
                </div>
            {% endif %}
        </div>

        <aside class="space-y-4">
            <div class="bg-white rounded-xl border border-neutral-200 p-5 text-sm space-y-2">
                <p><span class="text-neutral-500">{{ t('admin.date') }}:</span> {{ ds.created_at }}</p>
                <p><span class="text-neutral-500">{{ t('admin.status') }}:</span> <strong>{{ t('dropship.status.' ~ ds.status) }}</strong></p>
                <p><span class="text-neutral-500">{{ t('dropship.vendor_order_id') }}:</span> <span class="font-mono">{{ ds.vendor_order_id ?? '—' }}</span></p>
                <p><span class="text-neutral-500">{{ t('dropship.package_id') }}:</span> <span class="font-mono">{{ ds.dropship_package_id ?? '—' }}</span></p>
                <div class="flex justify-between border-t border-neutral-100 pt-2">
                    <span class="text-neutral-500">{{ t('dropship.wholesale_total') }}</span>
                    <strong>{{ ds.total_price|eur }}</strong>
                </div>
                <p class="text-xs text-neutral-400">{{ t('dropship.wholesale_note') }}</p>
            </div>

            {# ── Pacchetto dropship (package-details) ─────────────────── #}
            {% if vendor_package %}
                <div class="bg-white rounded-xl border border-neutral-200 p-5 text-sm space-y-2">
                    <h2 class="font-semibold">{{ t('dropship.package_title') }} <span class="font-mono text-xs text-neutral-400">#{{ vendor_package.package_id ?? ds.dropship_package_id }}</span></h2>
                    <p><span class="text-neutral-500">{{ t('dropship.package_status') }}:</span> <strong class="font-mono text-xs">{{ vendor_package.status ?? '—' }}</strong></p>
                    {% if vendor_package.total_order_count is defined and vendor_package.total_order_count is not null %}
                        <p><span class="text-neutral-500">{{ t('dropship.package_orders') }}:</span> {{ vendor_package.total_order_count }}</p>
                    {% endif %}
                    {% if vendor_package.total_order_price is defined and vendor_package.total_order_price is not null %}
                        <div class="flex justify-between border-t border-neutral-100 pt-2">
                            <span class="text-neutral-500">{{ t('dropship.package_total') }}</span>
                            <strong>{{ vendor_package.total_order_price|eur }}</strong>
                        </div>
                    {% endif %}
                    {% if vendor_package.last_update_date is defined and vendor_package.last_update_date %}
                        <p class="text-xs text-neutral-400">{{ t('dropship.package_updated') }}: {{ vendor_package.last_update_date }}</p>
                    {% endif %}
                </div>
            {% endif %}

            <div class="bg-white rounded-xl border border-neutral-200 p-5 text-sm space-y-2">
                <h2 class="font-semibold">{{ t('dropship.tracking') }}</h2>
                {% if tracking is empty %}
                    <p class="text-neutral-500 text-xs">{{ t('dropship.tracking_none') }}</p>
                {% else %}
                    <ul class="space-y-1">
                        {% for number in tracking %}
                            <li class="font-mono text-xs">{{ number }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {# ── Etichetta di spedizione (client_provides_shipping_label) ── #}
            {% if label_pending or ds.label_uploaded_at %}
                <div class="bg-white rounded-xl border {{ label_pending ? 'border-amber-300' : 'border-neutral-200' }} p-5 text-sm space-y-3">
                    <h2 class="font-semibold">{{ t('dropship.label_section') }}</h2>
                    {% if ds.label_uploaded_at %}
                        <p class="text-emerald-700">
                            ✓ {{ t('dropship.label_uploaded_at') }}: {{ ds.label_uploaded_at }}
                            {% if ds.label_file_name %}<span class="font-mono text-xs text-neutral-500 block">{{ ds.label_file_name }}</span>{% endif %}
                        </p>
                    {% else %}
                        <p class="rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-900">{{ t('dropship.label_pending_notice') }}</p>
                        <form method="post" action="/admin/dropship/{{ ds.id }}/etichetta" enctype="multipart/form-data" class="space-y-3">
                            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                            <div>
                                <label for="label-file" class="block text-xs font-medium mb-1">{{ t('dropship.label_file_label') }}</label>
                                <input type="file" id="label-file" name="shipping_label" required accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"
                                       class="w-full text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-neutral-900 file:text-white file:px-3 file:py-1.5 file:text-xs file:font-semibold hover:file:bg-neutral-700">
                            </div>
                            <div>
                                <label for="label-tracking" class="block text-xs font-medium mb-1">{{ t('dropship.label_tracking_label') }}</label>
                                <textarea id="label-tracking" name="tracking_numbers" rows="2" required
                                          class="w-full rounded-lg border-neutral-300 text-xs font-mono focus:border-amber-500 focus:ring-amber-500"></textarea>
                            </div>
                            <button type="submit" class="w-full rounded-lg bg-amber-400 text-neutral-900 font-bold py-2.5 hover:bg-amber-300">
                                {{ t('dropship.label_upload_button') }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}

            <form method="post" action="/admin/dropship/{{ ds.id }}/aggiorna">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button type="submit" class="w-full rounded-lg bg-neutral-900 text-white font-semibold py-2.5 hover:bg-neutral-700">
                    {{ t('dropship.refresh_status') }}
                </button>
            </form>
        </aside>
    </div>
{% endblock %}
