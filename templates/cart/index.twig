{% extends 'layout.twig' %}

{% block title %}{{ t('cart.title') }} — {{ t('app.title') }}{% endblock %}

{% block content %}
    <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
        <h1 class="text-2xl font-bold tracking-tight">{{ t('cart.title') }}</h1>
        {% if cart.products is not empty %}
            <span class="rounded-full bg-neutral-900 px-2.5 py-1 text-xs font-bold text-white">
                <span data-summary-items>{{ cart.total_items }}</span> {{ t('cart.pieces_long') }}
            </span>
            <a href="/catalogo" class="ml-auto inline-flex items-center gap-1.5 rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm font-medium transition-all hover:border-neutral-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                {{ t('cart.keep_shopping') }}
            </a>
        {% endif %}
    </div>

    {% if cart.products is empty %}
        <div class="rounded-2xl border border-neutral-200 bg-white p-12 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-neutral-100 text-neutral-400">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
            </div>
            <p class="font-semibold">{{ t('cart.empty') }}</p>
            <a href="/catalogo" class="mt-5 inline-block rounded-xl bg-neutral-900 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-neutral-700">{{ t('cart.go_catalog') }}</a>
        </div>
    {% else %}
        {# pb-32: spazio per la barra riepilogo fissa su mobile #}
        <div class="pb-32 lg:grid lg:grid-cols-3 lg:items-start lg:gap-6 lg:pb-0">
            <div class="space-y-4 lg:col-span-2">
                {% for product in cart.products %}
                    <section id="{{ product.sku }}" data-cart-product="{{ product.sku }}"
                             class="overflow-hidden rounded-2xl border border-neutral-200 bg-white">
                        <header class="flex items-start gap-3 border-b border-neutral-100 p-3 sm:p-4">
                            <img src="{{ product.image_url ?: '/placeholder.svg' }}" alt="" data-fallback="/placeholder.svg"
                                 class="h-16 w-16 shrink-0 rounded-xl bg-neutral-50 object-contain p-1 sm:h-14 sm:w-14">
                            <div class="min-w-0 flex-1">
                                <p class="text-xs text-neutral-500">
                                    <span class="font-mono font-semibold text-neutral-700">{{ product.sku }}</span> · {{ product.brand }}
                                </p>
                                <h2 class="truncate font-semibold leading-snug">{{ product.name }}</h2>
                                <p class="mt-0.5 text-xs text-neutral-500">
                                    <span data-product-items>{{ product.product_items }}</span> {{ t('cart.pieces') }} ·
                                    <strong class="text-neutral-900" data-product-total>{{ product.product_total|eur }}</strong>
                                </p>
                            </div>
                            <form method="post" action="/carrello/rimuovi" class="shrink-0">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <input type="hidden" name="sku" value="{{ product.sku }}">
                                <button type="submit" title="{{ t('cart.remove') }}" aria-label="{{ t('cart.remove') }}"
                                        class="rounded-lg p-2 text-neutral-400 transition-colors hover:bg-red-50 hover:text-red-600">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                                </button>
                            </form>
                        </header>

                        <div class="flex items-center gap-2 border-b border-neutral-100 px-3 py-2 sm:px-4">
                            <form method="post" action="/carrello/prendi-tutto">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <input type="hidden" name="sku" value="{{ product.sku }}">
                                <button type="submit" class="rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold transition-colors hover:bg-neutral-50">{{ t('cart.take_all') }}</button>
                            </form>
                            <form method="post" action="/carrello/svuota">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <input type="hidden" name="sku" value="{{ product.sku }}">
                                <button type="submit" class="rounded-lg border border-neutral-300 px-3 py-1.5 text-xs font-semibold transition-colors hover:bg-neutral-50">{{ t('cart.clear_product') }}</button>
                            </form>
                        </div>

                        {# ── Mobile/tablet: una tessera per taglia, niente scroll orizzontale ── #}
                        <div class="grid grid-cols-2 gap-2 p-3 sm:grid-cols-3 md:hidden">
                            {% for size in product.sizes %}
                                {% set label = size_system == 'us' and size.size_us ? size.size_us : size.size_eu %}
                                <div class="rounded-xl border p-2.5 transition-colors {{ size.quantity_stock == 0 ? 'border-neutral-100 bg-neutral-50/60 opacity-60' : (size.qty > 0 ? 'border-neutral-900 bg-neutral-50' : 'border-neutral-200') }}">
                                    <div class="flex items-baseline justify-between gap-1">
                                        <span class="font-bold">{{ label }}</span>
                                        <span class="text-[11px] {{ size.quantity_stock <= 3 ? 'font-semibold text-red-600' : 'text-neutral-400' }}">
                                            {{ size.quantity_stock }} {{ t('catalog.qv_in_stock') }}
                                        </span>
                                    </div>
                                    <div class="mt-0.5 text-xs font-semibold text-neutral-600">{{ size.price|eur }}</div>
                                    <div class="mt-2 flex items-center gap-1">
                                        <button type="button" data-qty-step="-1" aria-label="−" {{ size.quantity_stock == 0 ? 'disabled' }}
                                                class="h-8 w-8 shrink-0 rounded-lg border border-neutral-200 text-neutral-600 transition-colors hover:bg-neutral-100 disabled:opacity-40">−</button>
                                        <input type="number" value="{{ size.qty }}" min="0" max="{{ size.quantity_stock }}"
                                               {{ size.quantity_stock == 0 ? 'disabled' }} inputmode="numeric"
                                               data-cart-qty data-sku="{{ product.sku }}" data-size="{{ size.size_eu }}"
                                               class="h-8 w-full min-w-0 rounded-lg border-neutral-200 p-0 text-center text-sm focus:border-amber-500 focus:ring-amber-500 disabled:bg-neutral-100 disabled:text-neutral-300">
                                        <button type="button" data-qty-step="1" aria-label="+" {{ size.quantity_stock == 0 ? 'disabled' }}
                                                class="h-8 w-8 shrink-0 rounded-lg border border-neutral-200 text-neutral-600 transition-colors hover:bg-neutral-100 disabled:opacity-40">+</button>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        {# ── Desktop: tabella trasposta (densa, per ordini grandi) ── #}
                        <div class="hidden overflow-x-auto md:block">
                            <table class="w-full text-center text-sm">
                                <thead>
                                    <tr class="bg-neutral-50 text-neutral-500">
                                        <th class="sticky left-0 bg-neutral-50 px-3 py-2 text-left font-medium">{{ t('cart.size') }}</th>
                                        {% for size in product.sizes %}
                                            <th class="whitespace-nowrap px-2 py-2 font-semibold text-neutral-700">
                                                {{ size_system == 'us' and size.size_us ? size.size_us : size.size_eu }}
                                            </th>
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="border-t border-neutral-100">
                                        <th class="sticky left-0 bg-white px-3 py-2 text-left font-medium text-neutral-500">{{ t('cart.price') }}</th>
                                        {% for size in product.sizes %}
                                            <td class="whitespace-nowrap px-2 py-2">{{ size.price|eur }}</td>
                                        {% endfor %}
                                    </tr>
                                    <tr class="border-t border-neutral-100">
                                        <th class="sticky left-0 bg-white px-3 py-2 text-left font-medium text-neutral-500">{{ t('cart.stock') }}</th>
                                        {% for size in product.sizes %}
                                            <td class="px-2 py-2 font-semibold {{ size.quantity_stock <= 5 ? 'text-red-600' }}">{{ size.quantity_stock }}</td>
                                        {% endfor %}
                                    </tr>
                                    <tr class="border-t border-neutral-100">
                                        <th class="sticky left-0 bg-white px-3 py-2 text-left font-medium text-neutral-500">{{ t('cart.order_qty') }}</th>
                                        {% for size in product.sizes %}
                                            <td class="px-1.5 py-2">
                                                <input type="number" value="{{ size.qty }}" min="0" max="{{ size.quantity_stock }}"
                                                       {{ size.quantity_stock == 0 ? 'disabled' }}
                                                       data-cart-qty data-sku="{{ product.sku }}" data-size="{{ size.size_eu }}"
                                                       class="w-16 rounded-md border-neutral-300 text-center text-sm focus:border-amber-500 focus:ring-amber-500 disabled:bg-neutral-100 disabled:text-neutral-300"
                                                       inputmode="numeric">
                                            </td>
                                        {% endfor %}
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <footer class="border-t border-neutral-100 px-4 py-3 text-right text-sm">
                            {{ t('cart.product_subtotal') }}:
                            <strong data-product-total>{{ product.product_total|eur }}</strong>
                        </footer>
                    </section>
                {% endfor %}

                {# riepilogo completo sotto ai prodotti (mobile/tablet) #}
                <div class="lg:hidden">
                    {% include 'cart/_summary.twig' %}
                </div>
            </div>

            {# riepilogo sticky (desktop) #}
            <aside class="hidden lg:sticky lg:top-20 lg:block">
                {% include 'cart/_summary.twig' %}
            </aside>
        </div>

        {# ── Barra riepilogo fissa su mobile: totale sempre sotto il pollice ── #}
        <div class="fixed inset-x-0 bottom-0 z-40 border-t border-neutral-200 bg-white/95 px-4 py-3 shadow-[0_-4px_16px_rgba(0,0,0,.06)] backdrop-blur lg:hidden">
            <div class="flex items-center gap-3">
                <div class="min-w-0 flex-1">
                    <p class="truncate text-[11px] uppercase tracking-wide text-neutral-400">
                        <span data-summary-items>{{ cart.total_items }}</span> {{ t('cart.pieces') }} · {{ t('order.total_estimated') }}
                    </p>
                    <p class="truncate text-lg font-bold leading-tight" data-summary-gross>{{ cart_vat.gross|eur }}</p>
                    <p data-minimum-warning class="{{ meets_minimum ? 'hidden' }} truncate text-[11px] font-medium text-amber-700">
                        {{ t('cart.below_minimum', {n: max(0, min_order_items - cart.total_items)}) }}
                    </p>
                </div>
                <a href="/richiesta-ordine" data-proceed
                   class="shrink-0 rounded-xl px-4 py-2.5 text-sm font-semibold transition-all {{ meets_minimum ? 'bg-neutral-900 text-white active:scale-[.98]' : 'pointer-events-none bg-neutral-200 text-neutral-400' }}">
                    {{ t('cart.proceed') }}
                </a>
            </div>
        </div>
    {% endif %}
{% endblock %}
