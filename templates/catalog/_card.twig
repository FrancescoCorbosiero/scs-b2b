{# Card prodotto del catalogo.
   `data-product` alimenta la scheda rapida (quick view): SOLO dati pubblici
   (taglie, stock, prezzi netti di listino) — mai offer_price (Regola d'oro n.1). #}
{% set sizes = sizes_by_product[item.id] ?? [] %}
{% set in_stock_sizes = sizes|filter(s => s.quantity > 0) %}
{% set level = item.total_quantity >= availability_high_min ? 'alta'
             : (item.total_quantity <= availability_low_max ? 'bassa' : 'media') %}
{% set level_classes = {
    'alta': 'bg-emerald-50 text-emerald-700 border-emerald-200',
    'media': 'bg-amber-50 text-amber-800 border-amber-200',
    'bassa': 'bg-red-50 text-red-700 border-red-200',
} %}
{% set product_json = {
    sku: item.sku,
    name: item.name,
    brand: item.brand,
    image: item.image_url ?: '/placeholder.svg',
    total: item.total_quantity,
    recommended: item.is_recommended ? true : false,
    sizes: sizes,
}|json_encode %}

<article class="scs-reveal group relative flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white
                transition-all duration-200 hover:-translate-y-0.5 hover:border-neutral-300 hover:shadow-lg
                focus-within:ring-2 focus-within:ring-amber-500">
    {# immagine: cliccabile, apre la scheda rapida #}
    <button type="button" data-quickview data-product="{{ product_json|e('html_attr') }}"
            class="relative block aspect-square w-full overflow-hidden bg-neutral-50 focus:outline-none"
            aria-label="{{ t('catalog.quickview_of', {name: item.name})|e('html_attr') }}">
        <img src="{{ item.image_url ?: '/placeholder.svg' }}" alt="{{ item.name }}" loading="lazy" data-fallback="/placeholder.svg"
             class="absolute inset-0 h-full w-full object-contain p-4 transition-transform duration-300 group-hover:scale-105">

        <span class="absolute left-2 top-2 flex flex-col items-start gap-1">
            {% if item.is_recommended %}
                <span class="rounded-full bg-amber-400 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-neutral-900 shadow-sm">
                    {{ t('catalog.recommended_badge') }}
                </span>
            {% endif %}
            <span class="rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide {{ level_classes[level] }}">
                {{ t('catalog.availability_' ~ level) }} · {{ item.total_quantity }}
            </span>
        </span>

        {# invito all'azione che compare in hover (desktop) #}
        <span class="pointer-events-none absolute inset-x-0 bottom-0 hidden translate-y-2 bg-gradient-to-t from-neutral-900/85 to-transparent
                     px-3 pb-3 pt-8 text-center text-xs font-semibold text-white opacity-0 transition-all duration-200
                     group-hover:translate-y-0 group-hover:opacity-100 sm:block">
            {{ t('catalog.quickview_cta') }}
        </span>
    </button>

    <div class="flex flex-1 flex-col gap-2 p-4">
        <div class="flex items-center gap-2 text-xs text-neutral-500">
            <span class="font-mono font-semibold text-neutral-700">{{ item.sku }}</span>
            <button type="button" data-copy="{{ item.sku }}" title="{{ t('catalog.copy_sku') }}"
                    class="rounded p-1 text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-700">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75"/></svg>
            </button>
            <a href="{{ brand_prefix }}brand={{ item.brand|url_encode }}"
               class="ml-auto truncate rounded-full bg-neutral-100 px-2 py-0.5 font-semibold text-neutral-600 transition-colors hover:bg-neutral-900 hover:text-white">
                {{ item.brand }}
            </a>
        </div>

        <h2 class="scs-clamp-2 min-h-[2.6rem] font-semibold leading-snug">{{ item.name }}</h2>

        {# strip taglie disponibili: colpo d'occhio sulle misure in stock #}
        <div class="flex flex-wrap gap-1">
            {% for size in in_stock_sizes|slice(0, 7) %}
                {% set label = size_system == 'us' and size.size_us ? size.size_us : size.size_eu %}
                <span class="rounded-md border border-neutral-200 bg-neutral-50 px-1.5 py-0.5 text-[11px] font-medium text-neutral-700">
                    {{ label }}<span class="text-neutral-400">·{{ size.quantity }}</span>
                </span>
            {% else %}
                <span class="text-[11px] text-neutral-400">{{ t('catalog.no_sizes') }}</span>
            {% endfor %}
            {% if in_stock_sizes|length > 7 %}
                <span class="rounded-md px-1.5 py-0.5 text-[11px] font-semibold text-neutral-400">+{{ in_stock_sizes|length - 7 }}</span>
            {% endif %}
        </div>

        {# su card strette prezzo e CTA si impilano, sulle larghe stanno in riga #}
        <div class="mt-auto flex flex-col items-stretch gap-2 pt-3 sm:flex-row sm:items-end sm:justify-between sm:gap-3">
            <p class="leading-tight">
                <span class="block text-[11px] uppercase tracking-wide text-neutral-400">{{ t('catalog.price_from_label') }}</span>
                <span class="whitespace-nowrap text-lg font-bold">{{ item.price_from|eur }}</span>
            </p>
            {# senza JS: aggiunge il prodotto e porta al carrello per scegliere le taglie #}
            <form method="post" action="/carrello/aggiungi" data-quickview-form data-product="{{ product_json|e('html_attr') }}">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <input type="hidden" name="sku" value="{{ item.sku }}">
                <input type="hidden" name="redirect" value="{{ current_uri }}">
                <button type="submit"
                        class="inline-flex w-full items-center justify-center gap-1.5 rounded-xl bg-neutral-900 px-3.5 py-2.5 text-sm font-semibold text-white
                               transition-all hover:bg-neutral-700 active:scale-95 sm:w-auto">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
                    <span class="hidden sm:inline">{{ t('catalog.choose_sizes') }}</span>
                    <span class="sm:hidden">{{ t('catalog.add_short') }}</span>
                </button>
            </form>
        </div>
    </div>
</article>
