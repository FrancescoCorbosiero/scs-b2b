{% extends 'layout.twig' %}

{% block title %}{{ t('how.meta_title') }}{% endblock %}

{% block content %}
    <section class="relative overflow-hidden border-b border-neutral-200 bg-neutral-900 text-white">
        {# sfondo: illustrazione di serie o foto in public/img/custom/hero.* #}
        <img src="{{ images.hero }}" alt="" aria-hidden="true" fetchpriority="high"
             class="pointer-events-none absolute inset-0 h-full w-full object-cover object-left opacity-95 sm:object-center">
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-neutral-900/55 via-neutral-900/70 to-neutral-900"></div>
        <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:py-20">
            <p class="scs-reveal text-xs font-bold uppercase tracking-widest text-amber-400">{{ t('how.eyebrow') }}</p>
            <h1 class="scs-reveal mt-3 text-4xl font-black tracking-tight sm:text-5xl">{{ t('how.title') }}</h1>
            <p class="scs-reveal mt-4 text-lg text-neutral-300">{{ t('how.subtitle') }}</p>
        </div>
    </section>

    {# ── I 5 passi: timeline che si riempie mentre si scorre ── #}
    <section class="mx-auto max-w-4xl px-4 py-16 sm:py-20">
        <ol class="relative space-y-6">
            {# linea verticale della timeline (solo da sm in su) #}
            <span class="absolute left-[27px] top-4 hidden h-[calc(100%-2rem)] w-px bg-neutral-200 sm:block" aria-hidden="true"></span>

            {% set step_icons = {1: 'user', 2: 'cart', 3: 'bank', 4: 'check', 5: 'box'} %}
            {% for i in 1..5 %}
                <li data-reveal class="scs-step relative sm:pl-20">
                    <span class="absolute left-0 top-0 hidden h-14 w-14 items-center justify-center rounded-2xl border-2 border-neutral-900 bg-white text-lg font-black sm:flex">
                        {{ i }}
                    </span>
                    <article class="rounded-2xl border border-neutral-200 bg-white p-6 transition-all hover:border-neutral-300 hover:shadow-lg sm:p-7">
                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-neutral-900 text-amber-400 sm:hidden">
                                {% include 'pages/_icon.twig' with { name: step_icons[i] } %}
                            </span>
                            <div>
                                <p class="text-xs font-bold uppercase tracking-widest text-amber-600">{{ t('how.step_label', {n: i}) }}</p>
                                <h2 class="text-xl font-black tracking-tight">{{ t('steps.' ~ i ~ '_title') }}</h2>
                            </div>
                            <span class="ml-auto hidden h-11 w-11 items-center justify-center rounded-xl bg-neutral-100 text-neutral-700 sm:flex">
                                {% include 'pages/_icon.twig' with { name: step_icons[i] } %}
                            </span>
                        </div>
                        <p class="mt-4 leading-relaxed text-neutral-600">
                            {{ t('steps.' ~ i ~ '_text', {min: shipping.days_min, max: shipping.days_max, minimum: min_order_items, free: shipping.free_from}) }}
                        </p>

                        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                            {% for k in 1..2 %}
                                <li class="flex items-start gap-2 rounded-xl bg-neutral-50 px-3 py-2 text-sm text-neutral-600">
                                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                                    {{ t('steps.' ~ i ~ '_bullet_' ~ k, {min: shipping.days_min, max: shipping.days_max, minimum: min_order_items, free: shipping.free_from}) }}
                                </li>
                            {% endfor %}
                        </ul>
                    </article>
                </li>
            {% endfor %}
        </ol>

        {# ── Nota tempi ── #}
        <div data-reveal class="mt-10 flex flex-col gap-4 rounded-2xl border border-amber-200 bg-amber-50 p-6 sm:flex-row sm:items-center">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-400 text-neutral-900">
                {% include 'pages/_icon.twig' with { name: 'clock' } %}
            </span>
            <p class="text-sm leading-relaxed text-amber-900">
                {{ t('how.timing_note', {min: shipping.days_min, max: shipping.days_max, minimum: min_order_items}) }}
            </p>
        </div>
    </section>

    {# ── FAQ ────────────────────────────────────────────────────── #}
    <section class="border-t border-neutral-200 bg-white py-16 sm:py-20">
        <div class="mx-auto max-w-3xl px-4">
            <h2 class="scs-reveal text-3xl font-black tracking-tight">{{ t('how.faq_title') }}</h2>
            <div class="mt-8 divide-y divide-neutral-200 border-y border-neutral-200">
                {% for i in 1..5 %}
                    <div x-data="{ open: false }" data-reveal>
                        <button type="button" @click="open = !open"
                                class="flex w-full items-center justify-between gap-4 py-4 text-left font-semibold transition-colors hover:text-neutral-600">
                            {{ t('how.faq_' ~ i ~ '_q') }}
                            <svg class="h-5 w-5 shrink-0 transition-transform duration-200" :class="open && 'rotate-45'" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                        </button>
                        <div x-show="open" x-cloak x-transition.opacity.duration.150ms class="pb-5 text-sm leading-relaxed text-neutral-600">
                            {{ t('how.faq_' ~ i ~ '_a', {n: min_order_items, min: shipping.days_min, max: shipping.days_max}) }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="bg-neutral-900 py-16">
        <div class="mx-auto max-w-5xl px-4">
            <div data-reveal class="grid overflow-hidden rounded-3xl border border-neutral-800 bg-neutral-800/40 lg:grid-cols-5">
                <div class="relative min-h-[200px] lg:col-span-2">
                    <img src="{{ images.cta }}" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/60 to-transparent lg:bg-gradient-to-l"></div>
                </div>
                <div class="p-8 text-white sm:p-10 lg:col-span-3">
                    <h2 class="text-3xl font-black tracking-tight">{{ t('how.cta_title') }}</h2>
                    <p class="mt-3 text-neutral-300">{{ t('how.cta_text') }}</p>
                    <a href="{{ is_catalog_authed ? '/catalogo' : '/richiedi-accesso' }}"
                       class="mt-7 inline-block rounded-xl bg-amber-400 px-6 py-3.5 font-bold text-neutral-900 transition-all hover:bg-amber-300 active:scale-[.98]">
                        {{ is_catalog_authed ? t('nav.go_catalog') : t('home.cta_primary') }}
                    </a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
