{% extends 'layout.twig' %}

{% block title %}{{ t('home.meta_title') }}{% endblock %}

{#
  Home pubblica (indicizzabile): NESSUN prezzo e NESSUN prodotto del feed
  (Regola d'oro n.2). Le "schede prodotto" qui sotto sono illustrazioni
  generiche (pages/_sneaker.twig + barre scheletro), non dati del catalogo.
#}
{% set catalog_link = is_catalog_authed ? '/catalogo' : '/vetrina' %}
{% set countries_count = countries|length > 0 ? countries|length : 29 %}
{% set days = shipping.days_min ~ '–' ~ shipping.days_max %}

{% block content %}
    {# ── Hero ───────────────────────────────────────────────────── #}
    <section class="scs-grain relative isolate overflow-hidden bg-ink text-white">
        {# sfondo: illustrazione di serie o foto in public/img/custom/hero.* #}
        <img src="{{ images.hero }}" alt="" aria-hidden="true" fetchpriority="high"
             class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover object-left opacity-50 sm:object-center">
        <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/90 to-ink/40"></div>
        <div class="scs-grid-bg pointer-events-none absolute inset-0 -z-10"></div>
        <div class="scs-glow pointer-events-none absolute -right-32 -top-40 -z-10 h-[38rem] w-[38rem]"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-ink to-transparent"></div>

        <div class="mx-auto max-w-7xl px-4 pb-14 pt-14 sm:pb-20 sm:pt-20 lg:pt-24">
            <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_.9fr]">
                <div>
                    <p class="scs-reveal inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-neutral-200 backdrop-blur">
                        <span class="relative flex h-2 w-2">
                            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75 motion-reduce:animate-none"></span>
                            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                        </span>
                        {{ t('home.badge') }}
                    </p>
                    <h1 class="scs-reveal scs-display mt-6 text-[2.5rem] font-black leading-[.98] sm:text-6xl lg:text-[3.8rem]">
                        {{ t('home.hero_title') }}
                        <span class="scs-accent-text block">{{ t('home.hero_title_accent') }}</span>
                    </h1>
                    <p class="scs-reveal mt-6 max-w-xl text-base leading-relaxed text-neutral-300 sm:text-lg">{{ t('home.hero_subtitle') }}</p>

                    <div class="scs-reveal mt-9 flex flex-wrap gap-3">
                        {% if is_catalog_authed %}
                            <a href="/catalogo" class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-amber-400 px-7 py-4 sm:w-auto font-bold text-ink shadow-[0_10px_40px_-10px_rgba(251,191,36,.7)] transition-all hover:bg-amber-300 active:scale-[.98]">
                                {{ t('nav.go_catalog') }}
                                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                            </a>
                        {% else %}
                            {# la vetrina (catalogo senza prezzi) è la prima porta d'ingresso #}
                            <a href="/vetrina" class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-amber-400 px-7 py-4 sm:w-auto font-bold text-ink shadow-[0_10px_40px_-10px_rgba(251,191,36,.7)] transition-all hover:bg-amber-300 active:scale-[.98]">
                                {{ t('home.cta_browse') }}
                                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                            </a>
                            <a href="/richiedi-accesso" class="inline-flex flex-1 items-center justify-center rounded-full bg-white px-5 py-4 font-bold text-ink sm:flex-none sm:px-7 transition-all hover:bg-neutral-200 active:scale-[.98]">
                                {{ t('home.cta_primary') }}
                            </a>
                        {% endif %}
                        <a href="/come-ordinare" class="inline-flex flex-1 items-center justify-center rounded-full border border-white/20 px-5 py-4 font-semibold text-white sm:flex-none sm:px-6 transition-colors hover:border-white/50 hover:bg-white/5">
                            {{ t('home.cta_secondary') }}
                        </a>
                    </div>

                    <ul class="scs-reveal mt-9 flex flex-wrap gap-x-6 gap-y-2 text-sm text-neutral-400">
                        {% for item in [t('home.hero_trust_1'), t('home.hero_trust_2'), t('shipping.coverage_value')] %}
                            <li class="inline-flex items-center gap-2">
                                <svg class="h-4 w-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                                {{ item }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                {# su mobile: solo la "foto" illustrata della scheda #}
                <div class="scs-reveal relative lg:hidden" aria-hidden="true">
                    <div class="scs-glow absolute inset-0 -z-10"></div>
                    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-amber-200 via-amber-300 to-amber-500 px-8 pb-6 pt-12 sm:px-16">
                        <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-bold text-emerald-700">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{{ t('home.mock_available') }}
                        </span>
                        <span class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-ink/85 px-2.5 py-1 text-[11px] font-semibold text-neutral-200">
                            <svg class="h-3 w-3 text-amber-400" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                            {{ t('home.mock_price') }}
                        </span>
                        <div class="scs-float">
                            {% include 'pages/_sneaker.twig' with { class: 'mx-auto w-full max-w-sm h-auto -rotate-[4deg]', accent: 'fill-ink' } %}
                        </div>
                    </div>
                </div>

                {# mockup illustrativo della scheda catalogo: nessun dato reale #}
                <div class="scs-reveal relative mx-auto hidden w-full max-w-md lg:block" aria-hidden="true">
                    <div class="scs-glow absolute inset-8 -z-10"></div>
                    <div class="rotate-[2deg] rounded-[1.75rem] border border-white/10 bg-white/[.06] p-2.5 shadow-2xl shadow-black/60 ring-1 ring-white/5 backdrop-blur-xl transition-transform duration-500 hover:rotate-0">
                        <div class="flex items-center gap-1.5 px-2.5 pb-2.5 pt-1">
                            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
                            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
                            <span class="ml-3 flex-1 truncate rounded-full bg-white/10 px-3 py-1 text-[11px] text-neutral-400">{{ app_url|replace({'https://': '', 'http://': ''}) }}/catalogo</span>
                        </div>
                        <div class="rounded-[1.35rem] bg-ink-800 p-4">
                            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-amber-200 via-amber-300 to-amber-500 px-6 pb-4 pt-10">
                                <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-bold text-emerald-700">
                                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{{ t('home.mock_available') }}
                                </span>
                                <span class="absolute right-3 top-3 rounded-full bg-ink/80 px-2.5 py-1 font-mono text-[10px] tracking-wider text-amber-300">SKU ••••••</span>
                                <div class="scs-float">
                                    {% include 'pages/_sneaker.twig' with { class: 'mx-auto w-[88%] h-auto -rotate-[4deg]', accent: 'fill-ink' } %}
                                </div>
                            </div>
                            <div class="mt-4 space-y-2">
                                <div class="h-2.5 w-16 rounded-full bg-white/25"></div>
                                <div class="h-3.5 w-52 rounded-full bg-white/80"></div>
                            </div>
                            <p class="mt-4 text-[11px] font-semibold uppercase tracking-wider text-neutral-500">{{ t('home.mock_sizes') }}</p>
                            <div class="mt-2 grid grid-cols-4 gap-1.5">
                                {% for s in [
                                    {eu: '40', st: 'ok'}, {eu: '40.5', st: 'ok'}, {eu: '41', st: 'low'}, {eu: '42', st: 'ok'},
                                    {eu: '42.5', st: 'ok'}, {eu: '43', st: 'out'}, {eu: '44', st: 'low'}, {eu: '45', st: 'ok'}
                                ] %}
                                    <span class="flex items-center justify-between rounded-lg border px-2 py-1.5 text-xs font-semibold
                                        {{ s.st == 'out' ? 'border-white/5 text-neutral-600 line-through' : (loop.index == 4 ? 'border-amber-400 bg-amber-400/10 text-amber-300' : 'border-white/10 text-neutral-200') }}">
                                        {{ s.eu }}
                                        <span class="h-1.5 w-1.5 rounded-full {{ s.st == 'ok' ? 'bg-emerald-400' : (s.st == 'low' ? 'bg-amber-400' : 'bg-neutral-700') }}"></span>
                                    </span>
                                {% endfor %}
                            </div>
                            <div class="mt-4 flex items-center justify-between gap-3 rounded-xl bg-white/5 px-3 py-2.5">
                                <span class="text-xs text-neutral-400">{{ t('home.mock_price') }}</span>
                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-300">
                                    <svg class="h-3.5 w-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                                    {{ t('home.mock_price_locked') }}
                                </span>
                            </div>
                            <div class="mt-3 rounded-xl bg-amber-400 py-2.5 text-center text-sm font-bold text-ink">{{ t('home.mock_add') }}</div>
                        </div>
                    </div>

                    {# chip fluttuanti #}
                    <div class="scs-float-late absolute -left-20 top-[40%] flex items-center gap-3 rounded-2xl bg-white p-3 pr-4 text-ink shadow-xl shadow-black/40">
                        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-400">
                            <span class="scs-spin-slow inline-flex">{% include 'pages/_icon.twig' with { name: 'sync' } %}</span>
                        </span>
                        <span class="leading-tight">
                            <strong class="block text-sm">{{ t('home.chip_sync_title') }}</strong>
                            <span class="text-xs text-neutral-500">{{ t('home.chip_sync_text') }}</span>
                        </span>
                    </div>
                    <div class="scs-float absolute -bottom-8 -right-8 flex items-center gap-3 rounded-2xl border border-white/10 bg-ink-700/90 p-3 pr-4 shadow-xl shadow-black/40 backdrop-blur">
                        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-amber-400">
                            {% include 'pages/_icon.twig' with { name: 'truck' } %}
                        </span>
                        <span class="leading-tight">
                            <strong class="block text-sm">{{ t('home.chip_ship_title') }}</strong>
                            <span class="text-xs text-neutral-400">{{ t('home.chip_ship_text', {min: shipping.days_min, max: shipping.days_max}) }}</span>
                        </span>
                    </div>
                </div>
            </div>

            {# numeri chiave: nessun prezzo, solo informazioni commerciali #}
            <dl class="scs-reveal mt-16 grid grid-cols-2 overflow-hidden rounded-3xl border border-white/10 bg-white/[.03] backdrop-blur sm:grid-cols-4">
                {% for stat in [
                    {value: catalog_size > 0 ? catalog_size : null, suffix: '+', label: t('home.stat_models')},
                    {value: brands|length > 0 ? brands|length : null, suffix: '', label: t('home.stat_brands')},
                    {value: null, text: days, label: t('home.stat_days')},
                    {value: countries_count, suffix: '', label: t('home.stat_countries')}
                ] %}
                    <div class="flex flex-col-reverse gap-1 border-white/10 px-5 py-6 sm:px-7 {{ loop.index is odd ? 'border-r' }} {{ loop.index <= 2 ? 'border-b sm:border-b-0' }} {{ loop.index == 2 ? 'sm:border-r' }}">
                        <dt class="text-sm text-neutral-400">{{ stat.label }}</dt>
                        <dd class="scs-display text-4xl font-black text-white sm:text-5xl">
                            {% if stat.value is not null %}
                                <span data-countup="{{ stat.value }}" data-suffix="{{ stat.suffix }}">{{ stat.value }}{{ stat.suffix }}</span>
                            {% else %}
                                {{ stat.text ?? '—' }}
                            {% endif %}
                        </dd>
                    </div>
                {% endfor %}
            </dl>
        </div>
    </section>

    {# ── Brand: nastro che scorre, ognuno apre il catalogo filtrato ── #}
    {% if brand_links is not empty %}
        {% set brand_list = brand_links|slice(0, 14) %}
        <section class="border-b border-white/10 bg-ink py-10 text-white" aria-labelledby="brands-title">
            <p id="brands-title" class="mb-6 text-center text-xs font-semibold uppercase tracking-[.25em] text-neutral-500">{{ t('home.brands_title') }}</p>
            <div class="scs-marquee overflow-hidden">
                {# la traccia ripete la lista: solo la prima copia è navigabile #}
                <ul class="scs-marquee-track flex w-max items-center">
                    {% for copy in 1..4 %}
                        {% for brand in brand_list %}
                            {% set primary = copy == 1 %}
                            <li class="flex items-center {{ not primary ? 'scs-marquee-dup' }}" {% if not primary %}aria-hidden="true"{% endif %}>
                                <a href="{{ catalog_link }}?brand={{ brand|url_encode }}" {% if not primary %}tabindex="-1"{% endif %}
                                   class="scs-display px-6 text-4xl font-black uppercase transition-colors sm:px-8 sm:text-6xl {{ loop.index is odd ? 'text-white hover:text-amber-400' : 'scs-outline-text text-neutral-500 hover:text-amber-400' }}">{{ brand }}</a>
                                <span class="text-2xl text-amber-400" aria-hidden="true">✦</span>
                            </li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
            <p class="mt-7 text-center">
                <a href="{{ catalog_link }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber-400 underline-offset-4 hover:underline">
                    {{ t('home.brands_all_link') }}
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </a>
            </p>
        </section>
    {% endif %}

    {# ── Catalogo aperto: la vetrina senza prezzi, in evidenza ──── #}
    <section class="relative overflow-hidden bg-amber-400 text-ink">
        <div class="scs-grid-bg-light pointer-events-none absolute inset-0"></div>
        <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:py-20 lg:grid-cols-2">
            <div data-reveal>
                <p class="text-xs font-bold uppercase tracking-[.2em] text-ink/60">{{ t('home.showcase_eyebrow') }}</p>
                <h2 class="scs-display mt-3 text-4xl font-black leading-[1] sm:text-5xl lg:text-6xl">{{ t('home.showcase_title') }}</h2>
                <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink/75">{{ t('home.showcase_text') }}</p>
                <div class="mt-8 flex flex-wrap items-center gap-5">
                    <a href="{{ catalog_link }}"
                       class="group inline-flex items-center gap-3 rounded-full bg-ink py-2 pl-7 pr-2 text-lg font-bold text-white shadow-xl shadow-ink/20 transition-all hover:bg-ink-700 active:scale-[.98]">
                        {{ t('home.showcase_cta') }}
                        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-amber-400 text-ink transition-transform group-hover:rotate-[-45deg]">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                        </span>
                    </a>
                    {% if not is_catalog_authed %}
                        <span class="inline-flex items-center gap-2 text-sm font-semibold text-ink/70">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                            {{ t('home.showcase_note') }}
                        </span>
                    {% endif %}
                </div>
            </div>

            {# ventaglio di schede illustrative (si apre al passaggio del mouse) #}
            <a href="{{ catalog_link }}" class="group relative mx-auto hidden h-80 w-full max-w-lg sm:block" aria-hidden="true" tabindex="-1">
                {% for card in [
                    {pos: 'left-0 top-8 -rotate-[10deg] group-hover:-translate-x-6 group-hover:-rotate-[14deg]', tile: 'bg-ink', accent: 'fill-amber-400'},
                    {pos: 'right-0 top-8 rotate-[10deg] group-hover:translate-x-6 group-hover:rotate-[14deg]', tile: 'bg-emerald-200', accent: 'fill-emerald-600'},
                    {pos: 'left-1/2 top-0 -translate-x-1/2 group-hover:-translate-y-3', tile: 'bg-stone-200', accent: 'fill-rose-500'}
                ] %}
                    <div class="absolute w-56 rounded-3xl bg-white p-3 shadow-2xl shadow-ink/25 transition-transform duration-500 ease-out {{ card.pos }}">
                        <div class="rounded-2xl {{ card.tile }} px-4 py-7">
                            {% include 'pages/_sneaker.twig' with { class: 'w-full h-auto', accent: card.accent } %}
                        </div>
                        <div class="mt-3 space-y-1.5 px-1">
                            <div class="h-2 w-12 rounded-full bg-neutral-200"></div>
                            <div class="h-3 w-36 rounded-full bg-neutral-800"></div>
                        </div>
                        <div class="mt-3 flex items-center gap-1.5 rounded-xl bg-neutral-100 px-2.5 py-2 text-[11px] font-semibold text-neutral-500">
                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                            {{ t('home.mock_price') }}
                        </div>
                    </div>
                {% endfor %}
            </a>
        </div>
    </section>

    {# ── Perché noi: griglia "bento" con mini-illustrazioni ─────── #}
    <section class="relative bg-paper py-20 sm:py-28">
        {# texture leggera: illustrazione di serie o foto in public/img/custom/pattern.* #}
        <img src="{{ images.pattern }}" alt="" aria-hidden="true" loading="lazy"
             class="pointer-events-none absolute inset-x-0 top-0 h-96 w-full object-cover opacity-60">
        <div class="relative mx-auto max-w-7xl px-4">
            <div class="max-w-2xl" data-reveal>
                <p class="text-xs font-bold uppercase tracking-[.2em] text-amber-600">{{ t('home.value_eyebrow') }}</p>
                <h2 class="scs-display mt-3 text-3xl font-black leading-[1.05] sm:text-5xl">{{ t('home.value_title') }}</h2>
                <p class="mt-4 text-lg text-neutral-600">{{ t('home.value_subtitle') }}</p>
            </div>

            <div class="mt-12 grid gap-4 lg:grid-cols-6">
                {# 1. stock giornaliero: barre per taglia #}
                <article data-reveal data-spotlight class="scs-spotlight grid gap-8 overflow-hidden rounded-3xl bg-ink p-7 text-white sm:grid-cols-2 sm:p-9 lg:col-span-4">
                    <div class="flex flex-col">
                        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-amber-300">
                            <span class="scs-spin-slow inline-flex">{% include 'pages/_icon.twig' with { name: 'sync' } %}</span>
                            {{ t('home.mini_sync') }}
                        </span>
                        <h3 class="mt-6 text-2xl font-bold">{{ t('home.value_1_title') }}</h3>
                        <p class="mt-3 leading-relaxed text-neutral-400">{{ t('home.value_1_text') }}</p>
                    </div>
                    <div aria-hidden="true" class="flex flex-col justify-end">
                        <div class="flex h-44 items-end gap-2.5 border-b border-white/10">
                            {% for h in ['h-[45%]', 'h-[72%]', 'h-[100%]', 'h-[86%]', 'h-[58%]', 'h-[30%]'] %}
                                <span class="scs-bar flex-1 rounded-t-lg {{ h }} {{ loop.index == 3 ? 'bg-amber-400' : 'bg-white/15' }}"></span>
                            {% endfor %}
                        </div>
                        <div class="mt-2 flex gap-2.5 text-center text-xs font-semibold text-neutral-500">
                            {% for s in ['40', '41', '42', '43', '44', '45'] %}<span class="flex-1">{{ s }}</span>{% endfor %}
                        </div>
                        <p class="mt-3 text-xs text-neutral-500">{{ t('home.mini_stock_legend') }}</p>
                    </div>
                </article>

                {# 2. prezzi netti #}
                <article data-reveal data-spotlight class="scs-spotlight flex flex-col overflow-hidden rounded-3xl border border-neutral-200 bg-white p-7 sm:p-9 lg:col-span-2">
                    <div aria-hidden="true" class="flex items-center gap-3">
                        <span class="scs-display scs-outline-text text-6xl font-black text-ink">{{ t('home.mini_net') }}</span>
                    </div>
                    <span aria-hidden="true" class="mt-3 inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800">
                        {% include 'pages/_icon.twig' with { name: 'tag' } %}
                        {{ t('home.mini_vat_excluded') }}
                    </span>
                    <h3 class="mt-auto pt-8 text-xl font-bold">{{ t('home.value_2_title') }}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-neutral-600">{{ t('home.value_2_text') }}</p>
                </article>

                {# 3. taglia per taglia: selettore EU/US interattivo #}
                <article data-reveal data-spotlight x-data="{ us: false }" class="scs-spotlight flex flex-col rounded-3xl border border-neutral-200 bg-white p-7 sm:p-9 lg:col-span-2">
                    <div class="h-40">
                        <div class="flex items-center justify-between gap-3">
                            <div class="inline-flex rounded-full bg-neutral-100 p-1 text-xs font-bold" role="group" aria-label="{{ t('home.mini_size_hint') }}">
                                <button type="button" @click="us = false" :aria-pressed="!us" aria-pressed="true"
                                        class="rounded-full px-3.5 py-1.5 transition-colors" :class="us ? 'text-neutral-500' : 'bg-ink text-white'">EU</button>
                                <button type="button" @click="us = true" :aria-pressed="us" aria-pressed="false"
                                        class="rounded-full px-3.5 py-1.5 text-neutral-500 transition-colors" :class="us ? 'bg-ink text-white' : 'text-neutral-500'">US</button>
                            </div>
                            <span class="text-right text-xs text-neutral-400">{{ t('home.mini_size_hint') }}</span>
                        </div>
                        <div aria-hidden="true" class="mt-5 grid grid-cols-4 gap-1.5">
                            {% for s in [['40', '7'], ['40.5', '7.5'], ['41', '8'], ['42', '8.5'], ['42.5', '9'], ['43', '9.5'], ['44', '10'], ['45', '11']] %}
                                <span class="rounded-lg border py-2 text-center text-sm font-semibold {{ loop.index == 4 ? 'border-ink bg-ink text-amber-400' : 'border-neutral-200 text-neutral-700' }}">
                                    <span x-show="!us">{{ s[0] }}</span><span x-show="us" x-cloak>{{ s[1] }}</span>
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                    <h3 class="mt-7 text-xl font-bold">{{ t('home.value_3_title') }}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-neutral-600">{{ t('home.value_3_text') }}</p>
                </article>

                {# 4. spedizione: rotte dall'Italia #}
                <article data-reveal data-spotlight class="scs-spotlight flex flex-col rounded-3xl border border-neutral-200 bg-white p-7 sm:p-9 lg:col-span-2">
                    <div aria-hidden="true" class="relative h-40 overflow-hidden rounded-2xl bg-paper">
                        <span class="absolute left-3 top-3 rounded-full bg-emerald-100 px-2.5 py-1 text-[11px] font-bold text-emerald-700">{{ t('home.mini_free', {n: shipping.free_from}) }}</span>
                        <svg viewBox="0 0 240 120" class="absolute inset-0 h-full w-full" fill="none" preserveAspectRatio="xMidYMid meet">
                            <path d="M36 96 C 80 40, 150 22, 212 34" stroke="#f59e0b" stroke-width="2" class="scs-dash"/>
                            <path d="M36 96 C 100 84, 160 82, 214 92" stroke="#a3a3a3" stroke-width="2" class="scs-dash"/>
                            <path d="M36 96 C 86 62, 130 58, 160 62" stroke="#a3a3a3" stroke-width="2" class="scs-dash"/>
                            <circle cx="36" cy="96" r="14" class="fill-amber-400/25"/>
                            <circle cx="36" cy="96" r="8" class="fill-ink"/>
                            <circle cx="36" cy="96" r="3" class="fill-amber-400"/>
                            <circle cx="212" cy="34" r="5" class="fill-amber-400"/>
                            <circle cx="214" cy="92" r="5" class="fill-neutral-400"/>
                            <circle cx="160" cy="62" r="5" class="fill-neutral-400"/>
                            <text x="52" y="113" class="fill-neutral-500 text-[10px] font-bold">IT</text>
                        </svg>
                    </div>
                    <h3 class="mt-7 text-xl font-bold">{{ t('home.value_4_title') }}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-neutral-600">{{ t('home.value_4_text', {n: shipping.free_from, fee: shipping.fee|eur}) }}</p>
                </article>

                {# 5. bonifico: mini email con coordinate e causale #}
                <article data-reveal data-spotlight class="scs-spotlight flex flex-col rounded-3xl border border-neutral-200 bg-white p-7 sm:p-9 lg:col-span-2">
                    <div aria-hidden="true" class="flex h-40 flex-col justify-between rounded-2xl bg-paper p-4">
                        <div class="flex items-center gap-3">
                            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-ink text-amber-400">
                                {% include 'pages/_icon.twig' with { name: 'bank' } %}
                            </span>
                            <div class="space-y-1.5">
                                <div class="h-2.5 w-28 rounded-full bg-neutral-800"></div>
                                <div class="h-2 w-20 rounded-full bg-neutral-300"></div>
                            </div>
                        </div>
                        <div class="space-y-2 rounded-xl bg-white p-3 ring-1 ring-neutral-200">
                            <div class="flex items-center justify-between text-xs">
                                <span class="font-semibold text-neutral-500">{{ t('home.mini_iban') }}</span>
                                <span class="font-mono tracking-wider text-neutral-800">IT•• •••• •••• ••••</span>
                            </div>
                            <div class="flex items-center justify-between gap-2 text-xs">
                                <span class="font-semibold text-neutral-500">{{ t('home.mini_reference') }}</span>
                                <span class="inline-flex items-center gap-1 font-semibold text-emerald-700">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                                    {{ t('home.mini_reference_ready') }}
                                </span>
                            </div>
                        </div>
                    </div>
                    <h3 class="mt-7 text-xl font-bold">{{ t('home.value_5_title') }}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-neutral-600">{{ t('home.value_5_text') }}</p>
                </article>

                {# 6. ricevuta pro-forma: striscia larga #}
                <article data-reveal data-spotlight class="scs-spotlight grid items-center gap-8 overflow-hidden rounded-3xl border border-neutral-200 bg-white p-7 sm:grid-cols-[1fr_auto] sm:p-9 lg:col-span-6">
                    <div class="max-w-2xl">
                        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-ink text-amber-400">
                            {% include 'pages/_icon.twig' with { name: 'doc' } %}
                        </span>
                        <h3 class="mt-5 text-xl font-bold">{{ t('home.value_6_title') }}</h3>
                        <p class="mt-2 leading-relaxed text-neutral-600">{{ t('home.value_6_text') }}</p>
                    </div>
                    <div aria-hidden="true" class="relative mx-auto h-36 w-64">
                        <div class="absolute left-6 top-3 h-32 w-48 rotate-[-6deg] rounded-xl border border-neutral-200 bg-neutral-50"></div>
                        <div class="absolute left-12 top-0 h-36 w-48 rotate-[3deg] rounded-xl border border-neutral-200 bg-white p-4 shadow-xl shadow-neutral-900/10">
                            <div class="flex items-center justify-between">
                                <div class="h-2.5 w-14 rounded-full bg-ink"></div>
                                <span class="rounded bg-red-500 px-1.5 py-0.5 text-[9px] font-black text-white">PDF</span>
                            </div>
                            <div class="mt-4 space-y-1.5">
                                <div class="h-1.5 w-full rounded-full bg-neutral-200"></div>
                                <div class="h-1.5 w-5/6 rounded-full bg-neutral-200"></div>
                                <div class="h-1.5 w-4/6 rounded-full bg-neutral-200"></div>
                                <div class="h-1.5 w-5/6 rounded-full bg-neutral-200"></div>
                            </div>
                            <p class="mt-4 text-[10px] font-bold uppercase tracking-wider text-amber-600">{{ t('home.mini_pdf') }}</p>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    {# ── Come funziona: timeline che si riempie quando entra in vista ── #}
    <section class="border-y border-neutral-200 bg-white py-20 sm:py-28">
        <div class="mx-auto max-w-7xl px-4">
            <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
                <div class="max-w-2xl">
                    <p class="text-xs font-bold uppercase tracking-[.2em] text-amber-600">{{ t('home.steps_eyebrow') }}</p>
                    <h2 class="scs-display mt-3 text-3xl font-black leading-[1.05] sm:text-5xl">{{ t('home.steps_title') }}</h2>
                    <p class="mt-4 text-lg text-neutral-600">{{ t('home.steps_subtitle') }}</p>
                </div>
                <a href="/come-ordinare" class="group inline-flex items-center gap-2 rounded-full border border-neutral-300 px-5 py-3 text-sm font-semibold transition-colors hover:border-ink hover:bg-ink hover:text-white">
                    {{ t('home.steps_link') }}
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
            </div>

            {% set step_icons = {1: 'user', 2: 'cart', 3: 'bank', 4: 'check', 5: 'box'} %}
            <ol data-reveal class="relative mt-14 grid gap-10 pl-16 lg:grid-cols-5 lg:gap-6 lg:pl-0">
                {# binario: verticale su mobile, orizzontale da lg #}
                <span class="absolute bottom-6 left-7 top-6 w-0.5 bg-neutral-200 lg:bottom-auto lg:left-7 lg:right-[calc(20%-3rem)] lg:top-7 lg:h-0.5 lg:w-auto" aria-hidden="true">
                    <span class="scs-line-fill block h-full w-full bg-amber-400"></span>
                </span>
                {% for i in 1..5 %}
                    <li class="relative">
                        <span class="absolute -left-16 top-0 flex h-14 w-14 items-center justify-center rounded-full bg-ink text-amber-400 ring-8 ring-white lg:static">
                            {% include 'pages/_icon.twig' with { name: step_icons[i] } %}
                        </span>
                        <p class="scs-display text-sm font-black text-neutral-300 lg:mt-6">0{{ i }}</p>
                        <h3 class="mt-1 text-lg font-bold leading-snug">{{ t('steps.' ~ i ~ '_title') }}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-neutral-500">{{ t('steps.' ~ i ~ '_short') }}</p>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    {# ── Spedizioni + cosa cambia in base al paese ──────────────── #}
    {#
      Lo schema IVA rispecchia VatService::resolveScheme con partita IVA
      obbligatoria: IT → domestic, UE → reverse_charge, extra-UE → export.
      Senza JS il pannello mostra il paese della sessione.
    #}
    {% set checker = {} %}
    {% for c in countries %}
        {% set checker = checker|merge({(c.code): {name: c.name, flag: c.flag, scheme: c.code == 'IT' ? 'domestic' : (c.is_eu ? 'reverse_charge' : 'export')}}) %}
    {% endfor %}
    {% set current = checker[country] ?? (checker|first ?: {name: '', flag: '', scheme: 'domestic'}) %}
    <section class="scs-grain relative isolate overflow-hidden bg-ink py-20 text-white sm:py-28">
        <img src="{{ images.network }}" alt="" aria-hidden="true" loading="lazy"
             class="pointer-events-none absolute -left-64 top-1/2 -z-10 hidden h-[120%] -translate-y-1/2 opacity-20 lg:block">
        <div class="scs-glow pointer-events-none absolute -bottom-40 right-0 -z-10 h-[30rem] w-[30rem]"></div>

        <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 lg:grid-cols-2">
            <div data-reveal>
                <p class="text-xs font-bold uppercase tracking-[.2em] text-amber-400">{{ t('nav.shipping') }}</p>
                <h2 class="scs-display mt-3 text-3xl font-black leading-[1.05] sm:text-5xl">
                    {{ t('home.shipping_title', {min: shipping.days_min, max: shipping.days_max}) }}
                </h2>
                <p class="mt-5 max-w-xl text-lg leading-relaxed text-neutral-300">{{ t('home.shipping_text', {n: shipping.free_from, fee: shipping.fee|eur}) }}</p>
                <ul class="mt-8 grid gap-3 sm:grid-cols-3">
                    {% for row in [
                        {icon: 'clock', label: t('home.shipping_fact_1'), value: days ~ ' ' ~ t('shipping.working_days')},
                        {icon: 'box', label: t('home.shipping_fact_2'), value: t('shipping.free_from_value', {n: shipping.free_from})},
                        {icon: 'globe', label: t('home.shipping_fact_3'), value: t('shipping.coverage_value')}
                    ] %}
                        <li class="rounded-2xl border border-white/10 bg-white/[.04] p-4">
                            <span class="text-amber-400">{% include 'pages/_icon.twig' with { name: row.icon } %}</span>
                            <span class="mt-3 block text-xs text-neutral-400">{{ row.label }}</span>
                            <strong class="mt-0.5 block text-sm">{{ row.value }}</strong>
                        </li>
                    {% endfor %}
                </ul>
                <a href="/spedizioni" class="group mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 font-bold text-ink transition-colors hover:bg-amber-400">
                    {{ t('home.shipping_link') }}
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
            </div>

            {% if checker is not empty %}
                <div data-reveal class="rounded-[1.75rem] border border-white/10 bg-white/[.06] p-2.5 shadow-2xl shadow-black/50 backdrop-blur-xl"
                     x-data="{ code: '{{ checker[country] is defined ? country : checker|keys|first }}', list: {} }"
                     x-init="list = JSON.parse($el.dataset.countries)"
                     data-countries="{{ checker|json_encode }}">
                    <div class="rounded-[1.35rem] bg-white p-6 text-ink sm:p-8">
                        <p class="text-xs font-bold uppercase tracking-[.2em] text-amber-600">{{ t('home.checker_eyebrow') }}</p>
                        <h3 class="scs-display mt-2 text-2xl font-black">{{ t('home.checker_title') }}</h3>

                        <label for="checker-country" class="mt-6 block text-sm font-semibold text-neutral-600">{{ t('home.checker_label') }}</label>
                        <select id="checker-country" x-model="code"
                                class="mt-2 w-full rounded-xl border-neutral-300 py-3 pl-4 pr-10 text-base font-semibold focus:border-amber-500 focus:ring-amber-500">
                            {% for c in countries %}
                                <option value="{{ c.code }}" {{ country == c.code ? 'selected' }}>{{ c.flag }} {{ c.name }}</option>
                            {% endfor %}
                        </select>

                        <div class="mt-6 flex items-center gap-4 rounded-2xl bg-paper p-4">
                            <span class="text-4xl leading-none" x-text="list[code] ? list[code].flag : ''">{{ current.flag }}</span>
                            <p class="min-w-0 flex-1 truncate text-lg font-bold" x-text="list[code] ? list[code].name : ''">{{ current.name }}</p>
                            {% for scheme in ['domestic', 'reverse_charge', 'export'] %}
                                <span x-show="(list[code] ? list[code].scheme : '{{ current.scheme }}') === '{{ scheme }}'" {{ current.scheme != scheme ? 'x-cloak' }}
                                      class="shrink-0 rounded-full bg-amber-400 px-3 py-1 text-xs font-bold text-ink">{{ t('vat.scheme_short.' ~ scheme) }}</span>
                            {% endfor %}
                        </div>

                        <dl class="mt-5 divide-y divide-neutral-100 text-sm">
                            <div class="flex items-start justify-between gap-4 py-3">
                                <dt class="text-neutral-500">{{ t('home.checker_delivery') }}</dt>
                                <dd class="text-right font-semibold">{{ days }} {{ t('shipping.working_days') }}</dd>
                            </div>
                            <div class="flex items-start justify-between gap-4 py-3">
                                <dt class="text-neutral-500">{{ t('home.checker_shipping') }}</dt>
                                <dd class="text-right font-semibold">{{ t('home.checker_shipping_value', {n: shipping.free_from, fee: shipping.fee|eur}) }}</dd>
                            </div>
                            <div class="flex items-start justify-between gap-4 py-3">
                                <dt class="shrink-0 text-neutral-500">{{ t('home.checker_vat') }}</dt>
                                <dd class="text-right font-semibold">
                                    {% for scheme in ['domestic', 'reverse_charge', 'export'] %}
                                        <span x-show="(list[code] ? list[code].scheme : '{{ current.scheme }}') === '{{ scheme }}'" {{ current.scheme != scheme ? 'x-cloak' }}>{{ t('home.checker_scheme_' ~ scheme) }}</span>
                                    {% endfor %}
                                </dd>
                            </div>
                        </dl>
                        <p class="mt-4 rounded-xl bg-neutral-50 px-4 py-3 text-xs leading-relaxed text-neutral-500">{{ t('home.checker_note') }}</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>

    {# ── Domande frequenti (stesse risposte di /come-ordinare) ──── #}
    <section class="bg-paper py-20 sm:py-28">
        <div class="mx-auto grid max-w-7xl gap-12 px-4 lg:grid-cols-[.8fr_1.2fr]">
            <div data-reveal>
                <p class="text-xs font-bold uppercase tracking-[.2em] text-amber-600">{{ t('home.faq_eyebrow') }}</p>
                <h2 class="scs-display mt-3 text-3xl font-black leading-[1.05] sm:text-5xl">{{ t('how.faq_title') }}</h2>
                <p class="mt-4 text-lg text-neutral-600">{{ t('home.faq_text') }}</p>
                <a href="/come-ordinare" class="mt-6 inline-flex items-center gap-1.5 font-semibold underline decoration-amber-400 decoration-2 underline-offset-4 hover:text-amber-700">
                    {{ t('home.faq_more') }} →
                </a>
                {% if contact.email %}
                    <p class="mt-6 text-sm text-neutral-500">
                        {{ t('home.faq_contact') }}
                        <a href="mailto:{{ contact.email }}" class="font-semibold text-ink hover:text-amber-700">{{ contact.email }}</a>
                    </p>
                {% endif %}
            </div>
            <div class="space-y-3" data-reveal>
                {% for i in 1..5 %}
                    <details class="scs-faq group rounded-2xl border border-neutral-200 bg-white transition-shadow open:shadow-lg open:shadow-neutral-900/5" {{ i == 1 ? 'open' }}>
                        <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 font-bold">
                            {{ t('how.faq_' ~ i ~ '_q') }}
                            <span class="scs-faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-ink group-open:bg-amber-400">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
                            </span>
                        </summary>
                        <div class="scs-faq-body px-6 pb-6 leading-relaxed text-neutral-600">
                            {{ t('how.faq_' ~ i ~ '_a', {n: min_order_items, min: shipping.days_min, max: shipping.days_max}) }}
                        </div>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ── CTA finale ─────────────────────────────────────────────── #}
    {% if not is_catalog_authed %}
        <section class="bg-paper pb-20 sm:pb-28">
            <div class="mx-auto max-w-7xl px-4">
                <div data-reveal class="scs-grain relative isolate grid overflow-hidden rounded-[2rem] bg-ink text-white lg:grid-cols-[1.2fr_1fr]">
                    <div class="scs-grid-bg pointer-events-none absolute inset-0 -z-10"></div>
                    <div class="scs-glow pointer-events-none absolute -left-20 -top-32 -z-10 h-[28rem] w-[28rem]"></div>
                    <div class="flex flex-col justify-center p-8 sm:p-14">
                        <h2 class="scs-display text-4xl font-black leading-[1] sm:text-6xl">{{ t('home.final_title') }}</h2>
                        <p class="mt-5 max-w-lg text-lg text-neutral-300">{{ t('home.final_text') }}</p>
                        <div class="mt-9 flex flex-wrap gap-3">
                            <a href="/richiedi-accesso" class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-7 py-4 font-bold text-ink shadow-[0_10px_40px_-10px_rgba(251,191,36,.7)] transition-all hover:bg-amber-300 active:scale-[.98]">
                                {{ t('home.cta_primary') }}
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                            </a>
                            <a href="/login" class="inline-flex items-center rounded-full border border-white/20 px-7 py-4 font-semibold transition-colors hover:border-white/50 hover:bg-white/5">
                                {{ t('nav.login') }}
                            </a>
                        </div>
                        <p class="mt-5 text-xs text-neutral-500">{{ t('home.final_note') }}</p>
                    </div>
                    {# immagine: illustrazione di serie o foto in public/img/custom/cta.* #}
                    <div class="relative min-h-[260px] lg:min-h-[420px]">
                        <img src="{{ images.cta }}" alt="" aria-hidden="true" loading="lazy"
                             class="scs-fade-edges absolute inset-0 h-full w-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-transparent lg:bg-gradient-to-r"></div>
                    </div>
                </div>
            </div>
        </section>

        {# barra fissa su mobile: compare dopo la hero, sparisce in fondo #}
        <div x-data="{ show: false }"
             @scroll.window.throttle.100ms="show = window.scrollY > 700 && (window.innerHeight + window.scrollY) < document.body.scrollHeight - 500"
             x-show="show" x-cloak
             x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="translate-y-full opacity-0" x-transition:enter-end="translate-y-0 opacity-100"
             x-transition:leave="transition duration-200 ease-in" x-transition:leave-start="translate-y-0 opacity-100" x-transition:leave-end="translate-y-full opacity-0"
             class="fixed inset-x-3 bottom-3 z-30 flex gap-2 rounded-2xl border border-white/10 bg-ink/90 p-2 shadow-2xl shadow-black/40 backdrop-blur md:hidden">
            <a href="/vetrina" class="flex-1 rounded-xl border border-white/15 px-3 py-3 text-center text-sm font-semibold text-white">{{ t('home.cta_browse') }}</a>
            <a href="/richiedi-accesso" class="flex-1 rounded-xl bg-amber-400 px-3 py-3 text-center text-sm font-bold text-ink">{{ t('home.cta_primary') }}</a>
        </div>
    {% endif %}
{% endblock %}
