{% extends 'layout.twig' %}

{% block title %}{{ t('signup.meta_title') }}{% endblock %}

{% block content %}
    <section class="relative overflow-hidden border-b border-neutral-200 bg-neutral-900 text-white">
        {# sfondo: illustrazione di serie o foto in public/img/custom/hero.* #}
        <img src="{{ images.hero }}" alt="" aria-hidden="true" fetchpriority="high"
             class="pointer-events-none absolute inset-0 h-full w-full object-cover object-left opacity-95 sm:object-center">
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-neutral-900/55 via-neutral-900/70 to-neutral-900"></div>
        <div class="relative mx-auto max-w-4xl px-4 py-14 text-center sm:py-16">
            <p class="scs-reveal text-xs font-bold uppercase tracking-widest text-amber-400">{{ t('signup.eyebrow') }}</p>
            <h1 class="scs-reveal mt-3 text-4xl font-black tracking-tight sm:text-5xl">{{ t('signup.title') }}</h1>
            <p class="scs-reveal mt-4 text-lg text-neutral-300">{{ t('signup.subtitle') }}</p>
        </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
        {% if sent %}
            {# ── Richiesta inviata ── #}
            <div class="scs-pop mx-auto max-w-xl rounded-2xl border border-emerald-200 bg-white p-10 text-center">
                <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                    <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                <h2 class="text-2xl font-black tracking-tight">{{ t('signup.sent_title') }}</h2>
                <p class="mt-3 leading-relaxed text-neutral-600">{{ t('signup.sent_text') }}</p>
                <div class="mt-7 flex flex-wrap justify-center gap-3">
                    <a href="/come-ordinare" class="rounded-xl bg-neutral-900 px-5 py-3 font-semibold text-white transition-colors hover:bg-neutral-700">{{ t('home.cta_secondary') }}</a>
                    <a href="/" class="rounded-xl border border-neutral-300 px-5 py-3 font-semibold transition-colors hover:bg-neutral-100">{{ t('signup.back_home') }}</a>
                </div>
            </div>
        {% else %}
            <div class="grid gap-8 lg:grid-cols-3 lg:items-start">
                {# ── Form ── #}
                <form method="post" action="/richiedi-accesso" class="space-y-6 rounded-2xl border border-neutral-200 bg-white p-6 sm:p-8 lg:col-span-2">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    {# honeypot antispam: invisibile agli utenti, i bot lo compilano #}
                    <div class="hidden" aria-hidden="true">
                        <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
                    </div>

                    <fieldset class="space-y-4">
                        <legend class="text-xs font-bold uppercase tracking-widest text-neutral-400">{{ t('signup.section_company') }}</legend>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="sm:col-span-2">
                                <label for="s-company" class="mb-1 block text-sm font-medium">{{ t('signup.company') }} *</label>
                                <input type="text" id="s-company" name="company" required maxlength="128" value="{{ old.company ?? '' }}" autocomplete="organization"
                                       class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                            </div>
                            <div>
                                <label for="s-vat" class="mb-1 block text-sm font-medium">{{ t('signup.vat_number') }}</label>
                                <input type="text" id="s-vat" name="vat_number" maxlength="32" value="{{ old.vat_number ?? '' }}"
                                       placeholder="{{ t('order.vat_number_placeholder') }}"
                                       class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                                <p class="mt-1 text-xs text-neutral-400">{{ t('signup.vat_hint') }}</p>
                            </div>
                            <div>
                                <label for="s-country" class="mb-1 block text-sm font-medium">{{ t('order.country') }}</label>
                                <select id="s-country" name="country" required
                                        class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                                    {% set selected_country = old.country ?? country %}
                                    {% for c in countries %}
                                        <option value="{{ c.code }}" {{ selected_country == c.code ? 'selected' }}>{{ c.name }} ({{ c.code }})</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="sm:col-span-2">
                                <label for="s-street" class="mb-1 block text-sm font-medium">{{ t('order.street') }}</label>
                                <input type="text" id="s-street" name="address_street" required maxlength="255" value="{{ old.address_street ?? '' }}" autocomplete="street-address"
                                       class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                            </div>
                            <div>
                                <label for="s-city" class="mb-1 block text-sm font-medium">{{ t('order.city') }}</label>
                                <input type="text" id="s-city" name="address_city" required maxlength="128" value="{{ old.address_city ?? '' }}" autocomplete="address-level2"
                                       class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                            </div>
                            <div>
                                <label for="s-zip" class="mb-1 block text-sm font-medium">{{ t('order.zip') }}</label>
                                <input type="text" id="s-zip" name="address_zip" required maxlength="16" value="{{ old.address_zip ?? '' }}" autocomplete="postal-code"
                                       class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="space-y-4 border-t border-neutral-100 pt-6">
                        <legend class="text-xs font-bold uppercase tracking-widest text-neutral-400">{{ t('signup.section_contact') }}</legend>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <label for="s-name" class="mb-1 block text-sm font-medium">{{ t('signup.name') }} *</label>
                                <input type="text" id="s-name" name="name" required maxlength="128" value="{{ old.name ?? '' }}" autocomplete="name"
                                       class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                            </div>
                            <div>
                                <label for="s-phone" class="mb-1 block text-sm font-medium">{{ t('order.phone') }}</label>
                                <input type="tel" id="s-phone" name="phone" required maxlength="32" value="{{ old.phone ?? '' }}" autocomplete="tel"
                                       class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                            </div>
                            <div class="sm:col-span-2">
                                <label for="s-email" class="mb-1 block text-sm font-medium">{{ t('signup.email') }} *</label>
                                <input type="email" id="s-email" name="email" required maxlength="255" value="{{ old.email ?? '' }}" autocomplete="email"
                                       class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">
                                <p class="mt-1 text-xs text-neutral-400">{{ t('signup.email_hint') }}</p>
                            </div>
                            <div class="sm:col-span-2">
                                <label for="s-notes" class="mb-1 block text-sm font-medium">{{ t('signup.notes') }}</label>
                                <textarea id="s-notes" name="notes" rows="3" maxlength="2000" placeholder="{{ t('signup.notes_placeholder') }}"
                                          class="w-full rounded-xl border-neutral-300 transition-colors focus:border-amber-500 focus:ring-amber-500">{{ old.notes ?? '' }}</textarea>
                            </div>
                        </div>
                    </fieldset>

                    <div class="flex flex-col gap-3 border-t border-neutral-100 pt-6 sm:flex-row sm:items-center">
                        <button type="submit" class="rounded-xl bg-neutral-900 px-6 py-3.5 font-bold text-white transition-all hover:bg-neutral-700 active:scale-[.98]">
                            {{ t('signup.submit') }}
                        </button>
                        <p class="text-xs leading-relaxed text-neutral-500">{{ t('signup.privacy_note') }}</p>
                    </div>
                </form>

                {# ── Cosa succede dopo ── #}
                <aside class="space-y-4 lg:sticky lg:top-24">
                    <div class="rounded-2xl border border-neutral-200 bg-white p-6">
                        <h2 class="font-black tracking-tight">{{ t('signup.after_title') }}</h2>
                        <ol class="mt-4 space-y-4">
                            {% for i in 1..3 %}
                                <li class="flex gap-3">
                                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-neutral-900 text-xs font-black text-amber-400">{{ i }}</span>
                                    <div>
                                        <p class="text-sm font-semibold">{{ t('signup.after_' ~ i ~ '_title') }}</p>
                                        <p class="mt-0.5 text-sm leading-relaxed text-neutral-500">{{ t('signup.after_' ~ i ~ '_text') }}</p>
                                    </div>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-900 text-white">
                        <img src="{{ images.cta }}" alt="" aria-hidden="true" loading="lazy" class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-35">
                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-neutral-900 via-neutral-900/85 to-neutral-900/50"></div>
                        <p class="relative p-6 text-sm leading-relaxed text-neutral-200">{{ t('signup.why_data') }}</p>
                    </div>
                    <p class="text-center text-sm text-neutral-500">
                        {{ t('signup.already_customer') }}
                        <a href="/login" class="font-semibold text-neutral-900 underline underline-offset-2">{{ t('nav.login') }}</a>
                    </p>
                </aside>
            </div>
        {% endif %}
    </section>
{% endblock %}
